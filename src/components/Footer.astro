---
const serviceAreas = [
  { name: 'Runaway Bay, TX', href: '/service-areas/internet-provider-runaway-bay-tx' },
  { name: 'Bridgeport, TX', href: '/service-areas/rural-internet-bridgeport-tx' },
  { name: 'Decatur, TX', href: '/service-areas/high-speed-internet-decatur-tx' },
  { name: 'Alvord, TX', href: '/service-areas/high-speed-internet-alvord-tx' },
  { name: 'Paradise, TX', href: '/service-areas/internet-service-paradise-tx' },
];

const quickLinks = [
  { name: 'Home', href: '/' },
  { name: 'Plans & Pricing', href: '/plans-pricing' },
  { name: 'Business Internet', href: '/business-commercial-internet' },
  { name: 'How It Works', href: '/technology-how-fixed-wireless-works' },
  { name: 'About Us', href: '/about-us' },
  { name: 'Contact & Support', href: '/contact' },
  { name: 'Check Address Coverage', href: '/#service-check' },
  { name: 'Live Network Status', href: 'https://status.infinilinkbroadband.com', external: true },
];
---

<footer class="bg-[#0B1F3A] border-t-2 border-[#162E52] text-slate-200 text-base" aria-labelledby="footer-heading">
  <h2 id="footer-heading" class="sr-only">Footer Information and Navigation</h2>
  
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10 mb-12">
      
      <!-- Brand & Direct Contact Column -->
      <div class="space-y-4">
        <div class="flex items-center space-x-3">
          <div class="w-12 h-12 rounded-xl bg-gradient-to-tr from-blue-700 via-sky-600 to-cyan-600 flex items-center justify-center p-2 shadow-md">
            <svg class="w-8 h-8 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M8.111 16.404a5.5 5.5 0 017.778 0M12 20h.01m-7.08-7.071c3.904-3.905 10.236-3.905 14.14 0M1.393 9.393c5.857-5.857 15.355-5.857 21.213 0"></path>
            </svg>
          </div>
          <div>
            <span class="text-2xl font-black tracking-tight text-white block leading-none">INFINILINK</span>
            <span class="text-sm tracking-wider uppercase font-bold text-sky-400 mt-1 block">BROADBAND</span>
          </div>
        </div>

        <p class="text-slate-300 leading-relaxed text-base">
          Wise County's local fixed wireless internet company. Run by a local family with three separate fiber lines feeding our network. Real people, real speeds, and zero contracts.
        </p>
        
        <div class="space-y-3 pt-2 text-base">
          <div>
            <a 
              href="tel:+19404370550" 
              class="inline-flex items-center text-white hover:text-sky-300 font-extrabold text-lg transition touch-target"
              data-track="call-footer"
            >
              <svg class="w-5 h-5 mr-2 text-sky-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
              </svg>
              (940) 437-0550
            </a>
          </div>

          <div>
            <a 
              href="https://billing.infinilinkbroadband.com" 
              class="inline-flex items-center text-sky-300 hover:text-white font-bold text-base underline underline-offset-4 touch-target"
              data-track="portal-footer"
            >
              <svg class="w-5 h-5 mr-2 text-sky-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
              </svg>
              Pay My Bill / Customer Portal
            </a>
          </div>

          <div>
            <a 
              href="mailto:support@infinilinkbroadband.com" 
              class="inline-flex items-center text-slate-300 hover:text-white font-medium text-sm transition touch-target"
            >
              <svg class="w-4 h-4 mr-2 text-sky-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
              </svg>
              support@infinilinkbroadband.com
            </a>
          </div>
        </div>

        <!-- Social & Map Links -->
        <div class="flex items-center space-x-3 pt-2">
          <a 
            href="https://www.facebook.com/infinilinkbroadband" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="w-10 h-10 rounded-lg bg-[#162E52] border border-slate-600 text-white hover:text-sky-300 hover:bg-[#1E3F70] flex items-center justify-center transition shadow-sm touch-target"
            aria-label="Infinilink Facebook Page (opens in new tab)"
          >
            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
            </svg>
          </a>
          <a 
            href="https://www.google.com/maps/place/Infinilink+Broadband/@33.1709744,-97.8963515,4580m/data=!3m1!1e3!4m6!3m5!1s0x86520cc4281a4471:0x9bec41ac337c3c1a!8m2!3d33.173094!4d-97.8998028!16s%2Fg%2F11c3x99zby?entry=ttu" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="w-10 h-10 rounded-lg bg-[#162E52] border border-slate-600 text-white hover:text-sky-300 hover:bg-[#1E3F70] flex items-center justify-center transition shadow-sm touch-target"
            aria-label="Infinilink on Google Maps (opens in new tab)"
          >
            <svg class="w-5 h-5 text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
            </svg>
          </a>
        </div>
      </div>

      <!-- Wise County Local Service Areas (Changed h4 -> h2 for proper WCAG heading order) -->
      <div>
        <h2 class="text-white font-extrabold text-lg mb-4 tracking-wide uppercase">Wise County Service Hubs</h2>
        <ul class="space-y-3">
          {serviceAreas.map((area) => (
            <li>
              <a 
                href={area.href} 
                class="text-slate-200 hover:text-sky-300 transition-colors flex items-center gap-2 group font-semibold text-base min-h-[30px]"
              >
                <span class="w-2 h-2 rounded-full bg-sky-400 group-hover:scale-125 transition-transform" aria-hidden="true"></span>
                <span>{area.name}</span>
              </a>
            </li>
          ))}
          <li class="pt-2 text-sm text-slate-300 leading-normal">
            Also serving Chico, Boyd, Slidell, Greenwood, and surrounding rural ranches.
          </li>
        </ul>
      </div>

      <!-- Quick Navigation Links (Changed to h2) -->
      <div>
        <h2 class="text-white font-extrabold text-lg mb-4 tracking-wide uppercase">Navigation & Links</h2>
        <ul class="space-y-2.5">
          {quickLinks.map((link) => (
            <li>
              <a 
                href={link.href} 
                class="text-slate-200 hover:text-sky-300 transition-colors font-semibold text-base flex items-center gap-1.5 min-h-[30px]"
                target={link.external ? "_blank" : undefined}
                rel={link.external ? "noopener noreferrer" : undefined}
              >
                <span>{link.name}</span>
                {link.external && (
                  <svg class="w-3.5 h-3.5 text-sky-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
                  </svg>
                )}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Trust, Status & Local Headquarters (Changed to h2) -->
      <div>
        <h2 class="text-white font-extrabold text-lg mb-4 tracking-wide uppercase">Local Operations</h2>
        <div class="bg-[#162E52] border border-[#254677] p-5 rounded-2xl shadow-sm space-y-4">
          <div class="flex items-start gap-3">
            <svg class="w-6 h-6 text-emerald-400 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
            </svg>
            <div>
              <p class="text-white font-bold text-base">Network Track Record</p>
              <p class="text-sm text-slate-300 mt-0.5">
                <a 
                  href="https://status.infinilinkbroadband.com" 
                  target="_blank" 
                  rel="noopener noreferrer" 
                  class="text-sky-300 font-semibold hover:underline"
                >
                  100% uptime over the last 90 days →
                </a>
              </p>
            </div>
          </div>

          <div class="flex items-start gap-3">
            <svg class="w-6 h-6 text-sky-400 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
            </svg>
            <div>
              <p class="text-white font-bold text-base">Neighbor-to-Neighbor Support</p>
              <p class="text-sm text-slate-300 mt-0.5">
                Most problems solved within the hour, by phone or text. Real people answer.
              </p>
            </div>
          </div>

          <div class="flex items-start gap-3 pt-2 border-t border-[#254677]">
            <svg class="w-6 h-6 text-slate-300 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
            </svg>
            <div>
              <p class="text-white font-bold text-base">Office & Mailing Address</p>
              <p class="text-sm text-slate-300 mt-0.5">101 Cooper Ct, Runaway Bay, TX 76426</p>
            </div>
          </div>
        </div>
      </div>

    </div>

    <!-- Bottom Legal Bar -->
    <div class="border-t border-[#162E52] pt-8 flex flex-col md:flex-row justify-between items-center gap-4 text-sm text-slate-300">
      <p>© {new Date().getFullYear()} Infinilink Broadband. All Rights Reserved. Locally Owned & Operated in Wise County, Texas.</p>
      <div class="flex flex-wrap items-center gap-x-6 gap-y-2 font-semibold">
        <a href="/plans-pricing" class="hover:text-white transition py-1">Plans & Pricing</a>
        <a href="/contact" class="hover:text-white transition py-1">Contact</a>
        <a href="/terms-of-use" class="hover:text-white transition py-1">Terms of Use</a>
        <a href="/privacy-policy" class="hover:text-white transition py-1">Privacy Policy</a>
        <a href="/accessibility" class="hover:text-white transition py-1">Accessibility Statement</a>
        <a href="https://billing.infinilinkbroadband.com" class="hover:text-white transition py-1">Pay My Bill</a>
      </div>
    </div>
  </div>
</footer>
