---
const navLinks = [
  { name: 'Plans & Pricing', href: '/plans-pricing' },
  { name: 'How It Works', href: '/technology-how-fixed-wireless-works' },
  { name: 'Business Internet', href: '/business-commercial-internet' },
  { name: 'Service Areas', href: '/service-areas/high-speed-internet-decatur-tx' },
  { name: 'Guides & Blog', href: '/blog' },
  { name: 'Contact', href: '/contact' },
];
---

<header class="sticky top-0 z-50 bg-slate-950/85 backdrop-blur-xl border-b border-slate-800/80 text-white">
  <!-- Top Utility Bar with Local Phone Contact -->
  <div class="bg-slate-900/90 border-b border-slate-800/50 py-1.5 px-4 text-xs font-medium text-slate-300">
    <div class="max-w-7xl mx-auto flex flex-wrap justify-between items-center gap-2">
      <div class="flex items-center gap-2">
        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-semibold bg-emerald-950 text-emerald-400 border border-emerald-800">
          <span class="w-1.5 h-1.5 mr-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
          Wise County Towers Active
        </span>
        <span class="hidden sm:inline text-slate-400">Decatur • Runaway Bay • Bridgeport • Alvord • Paradise • Boyd</span>
      </div>
      <div class="flex items-center gap-4">
        <span class="text-slate-400 hidden md:inline">Local Family-Owned Support</span>
        <a 
          href="tel:9404370550" 
          class="text-cyan-400 font-bold hover:text-cyan-300 transition flex items-center gap-1.5"
          id="nav-top-phone"
        >
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
          </svg>
          (940) 437-0550
        </a>
      </div>
    </div>
  </div>

  <!-- Main Navigation Bar -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      
      <!-- Brand Logo -->
      <a href="/" class="flex items-center space-x-3 group" aria-label="Infinilink Broadband Home">
        <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-blue-600 via-cyan-500 to-sky-400 flex items-center justify-center p-2 shadow-lg shadow-blue-500/20 group-hover:scale-105 transition-transform duration-200">
          <svg class="w-6 h-6 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M8.111 16.404a5.5 5.5 0 017.778 0M12 20h.01m-7.08-7.071c3.904-3.905 10.236-3.905 14.14 0M1.393 9.393c5.857-5.857 15.355-5.857 21.213 0"></path>
          </svg>
        </div>
        <div>
          <span class="text-xl sm:text-2xl font-black tracking-tight text-white group-hover:text-cyan-400 transition">INFINILINK</span>
          <span class="block text-[10px] tracking-widest uppercase font-semibold text-cyan-400 -mt-1">BROADBAND</span>
        </div>
      </a>

      <!-- Desktop Nav Links -->
      <nav class="hidden lg:flex items-center space-x-7 text-sm font-medium">
        {navLinks.map((link) => (
          <a 
            href={link.href} 
            class="text-slate-300 hover:text-cyan-400 transition-colors py-2"
          >
            {link.name}
          </a>
        ))}
      </nav>

      <!-- Action Buttons (Zero client-side runtime dependency) -->
      <div class="hidden sm:flex items-center space-x-3">
        <a 
          href="tel:9404370550" 
          class="text-slate-300 hover:text-white px-3 py-2 text-sm font-semibold flex items-center gap-1.5 transition"
        >
          <span>Call Us</span>
        </a>
        <a 
          href="/#service-check" 
          class="bg-gradient-to-r from-blue-600 to-cyan-600 hover:from-blue-500 hover:to-cyan-500 text-white font-bold text-sm px-5 py-2.5 rounded-lg shadow-md hover:shadow-cyan-500/25 transition duration-200"
        >
          Check Address
        </a>
      </div>

      <!-- Mobile Menu Toggle (Semantic zero-JS details element) -->
      <div class="lg:hidden">
        <details class="group relative">
          <summary class="list-none p-2 text-slate-300 hover:text-white cursor-pointer rounded-lg border border-slate-800 bg-slate-900" aria-label="Toggle navigation menu">
            <svg class="w-6 h-6 block group-open:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
            </svg>
            <svg class="w-6 h-6 hidden group-open:block" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
            </svg>
          </summary>
          <div class="absolute right-0 mt-3 w-72 bg-slate-900 border border-slate-800 rounded-xl shadow-2xl p-4 flex flex-col space-y-3 z-50">
            {navLinks.map((link) => (
              <a 
                href={link.href} 
                class="text-slate-200 hover:text-cyan-400 font-medium py-1.5 px-3 rounded hover:bg-slate-800 transition"
              >
                {link.name}
              </a>
            ))}
            <div class="pt-3 border-t border-slate-800 flex flex-col space-y-2">
              <a 
                href="tel:9404370550" 
                class="text-center font-bold text-cyan-400 py-2 rounded bg-slate-800/80"
              >
                Call: (940) 437-0550
              </a>
              <a 
                href="/#service-check" 
                class="text-center font-bold text-white bg-blue-600 py-2.5 rounded hover:bg-blue-500 transition"
              >
                Check Availability
              </a>
            </div>
          </div>
        </details>
      </div>

    </div>
  </div>
</header>
