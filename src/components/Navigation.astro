---
// Senior-friendly Navy Header with high-contrast accessibility and prominent Call/Portal buttons
const navLinks = [
  { name: 'Plans & Pricing', href: '/plans-pricing' },
  { name: 'How It Works', href: '/technology-how-fixed-wireless-works' },
  { name: 'Service Areas', href: '/service-areas/high-speed-internet-decatur-tx' },
  { name: 'About Us', href: '/about-us' },
  { name: 'Contact', href: '/contact' },
];
---

<header class="sticky top-0 z-50 bg-[#0B1F3A] border-b border-[#162E52] text-white shadow-md">
  <!-- Top Utility Bar: Trust & Instant Actions for Seniors & Busy Customers -->
  <div class="bg-[#071527] border-b border-[#162E52] py-2 px-4 text-sm font-medium text-slate-200">
    <div class="max-w-7xl mx-auto flex flex-wrap justify-between items-center gap-3">
      <div class="flex items-center gap-2">
        <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs sm:text-sm font-bold bg-emerald-950 text-emerald-300 border border-emerald-700">
          <span class="w-2 h-2 mr-2 rounded-full bg-emerald-400 animate-pulse" aria-hidden="true"></span>
          Wise County Towers Active
        </span>
        <span class="hidden md:inline text-slate-300 text-sm">
          Runaway Bay • Bridgeport • Decatur • Alvord • Paradise
        </span>
      </div>

      <!-- Quick Action on Top Bar (Visible on All Devices) -->
      <div class="flex items-center gap-3 sm:gap-4 ml-auto sm:ml-0">
        <a 
          href="https://billing.infinilinkbroadband.com" 
          class="text-xs sm:text-sm font-bold text-sky-300 hover:text-white underline underline-offset-4 touch-target px-2"
          data-track="portal-topbar"
        >
          Customer Portal / Pay My Bill
        </a>
        <span class="text-slate-500 hidden sm:inline" aria-hidden="true">|</span>
        <a 
          href="tel:+19404370550" 
          class="inline-flex items-center gap-1.5 text-sm sm:text-base font-extrabold text-white hover:text-sky-300 transition touch-target"
          id="nav-top-phone"
          data-track="call-header"
        >
          <svg class="w-4 h-4 text-sky-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
          </svg>
          <span>(940) 437-0550</span>
        </a>
      </div>
    </div>
  </div>

  <!-- Main Navigation Bar -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between min-h-[5rem] py-3 gap-4">
      
      <!-- Brand Logo (Original SVG Logo Preserved, Subtext >= 14px) -->
      <a href="/" class="flex items-center space-x-3 group flex-shrink-0 touch-target" aria-label="Infinilink Broadband">
        <div class="w-12 h-12 rounded-xl bg-gradient-to-tr from-blue-700 via-sky-600 to-cyan-600 flex items-center justify-center p-2 shadow-md">
          <svg class="w-8 h-8 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M8.111 16.404a5.5 5.5 0 017.778 0M12 20h.01m-7.08-7.071c3.904-3.905 10.236-3.905 14.14 0M1.393 9.393c5.857-5.857 15.355-5.857 21.213 0"></path>
          </svg>
        </div>
        <div class="flex flex-col">
          <span class="text-2xl sm:text-3xl font-black tracking-tight text-white leading-none">INFINILINK</span>
          <span class="text-sm tracking-wider uppercase font-bold text-sky-300 mt-1">BROADBAND</span>
        </div>
      </a>

      <!-- Desktop Nav Links (Short & at least 18px text) -->
      <nav class="hidden lg:flex items-center space-x-6 xl:space-x-8" aria-label="Main Navigation">
        {navLinks.map((link) => (
          <a 
            href={link.href} 
            class="text-lg font-semibold text-slate-100 hover:text-sky-300 transition-colors py-2 px-1 focus-visible:rounded"
          >
            {link.name}
          </a>
        ))}
      </nav>

      <!-- Senior-Friendly Desktop Action Buttons -->
      <div class="hidden sm:flex items-center space-x-3">
        <!-- Prominent Pay Bill / Portal Button (Opens in same tab) -->
        <a 
          href="https://billing.infinilinkbroadband.com" 
          class="bg-[#162E52] hover:bg-[#1E3F70] text-white border-2 border-sky-400/60 hover:border-sky-300 px-4 py-3 text-base font-bold rounded-xl flex items-center gap-2 transition touch-target shadow-sm"
          data-track="portal-header"
        >
          <svg class="w-5 h-5 text-sky-300 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
          </svg>
          <span>Pay My Bill / Portal</span>
        </a>

        <!-- Large Click-to-Call Button -->
        <a 
          href="tel:+19404370550" 
          class="bg-[#0060B6] hover:bg-[#004D91] text-white font-black text-base px-5 py-3 rounded-xl shadow-md hover:shadow-lg transition flex items-center gap-2 touch-target"
          data-track="call-header-btn"
          aria-label="Call 940-437-0550"
        >
          <svg class="w-5 h-5 text-white flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
          </svg>
          <span>Call (940) 437-0550</span>
        </a>
      </div>

      <!-- Mobile Navigation & Buttons (Portal & Call MUST stay visible on mobile) -->
      <div class="flex items-center gap-2 lg:hidden">
        <!-- Quick Call Button visible on small screens -->
        <a 
          href="tel:+19404370550" 
          class="bg-[#0060B6] hover:bg-[#004D91] text-white p-2.5 sm:px-3 sm:py-2 rounded-lg text-sm font-bold flex items-center gap-1.5 touch-target shadow-sm"
          data-track="call-header-mobile"
          aria-label="Call 940-437-0550"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
          </svg>
          <span class="hidden xs:inline">Call</span>
        </a>

        <!-- Quick Portal Button visible on small screens -->
        <a 
          href="https://billing.infinilinkbroadband.com" 
          class="bg-[#162E52] text-white border border-sky-400 p-2.5 sm:px-3 sm:py-2 rounded-lg text-xs sm:text-sm font-bold flex items-center gap-1 touch-target shadow-sm"
          data-track="portal-header-mobile"
          aria-label="Pay My Bill / Portal"
        >
          <span>Portal</span>
        </a>

        <!-- Hamburger for remaining links -->
        <details class="group relative">
          <summary 
            class="list-none p-2.5 text-white cursor-pointer rounded-lg border border-slate-600 bg-[#162E52] hover:bg-[#1E3F70] touch-target"
            aria-label="Toggle menu"
          >
            <svg class="w-6 h-6 block group-open:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
            </svg>
            <svg class="w-6 h-6 hidden group-open:block" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
            </svg>
          </summary>
          <div class="absolute right-0 mt-3 w-80 bg-[#0B1F3A] border-2 border-[#162E52] rounded-2xl shadow-2xl p-5 flex flex-col space-y-3 z-50">
            <nav aria-label="Mobile Navigation" class="flex flex-col space-y-2">
              {navLinks.map((link) => (
                <a 
                  href={link.href} 
                  class="text-white hover:text-sky-300 font-bold text-lg py-2.5 px-3 rounded-lg hover:bg-[#162E52] transition touch-target"
                >
                  {link.name}
                </a>
              ))}
            </nav>
            <div class="pt-4 border-t border-slate-700 flex flex-col space-y-3">
              <a 
                href="https://billing.infinilinkbroadband.com" 
                class="text-center font-bold text-white py-3 rounded-xl bg-[#162E52] border border-sky-400 hover:bg-[#1E3F70] transition text-base flex items-center justify-center gap-2 touch-target"
                data-track="portal-menu-mobile"
              >
                <svg class="w-5 h-5 text-sky-300" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                </svg>
                Customer Portal / Pay My Bill
              </a>
              <a 
                href="tel:+19404370550" 
                class="text-center font-black text-white py-3.5 rounded-xl bg-[#0060B6] hover:bg-[#004D91] transition text-lg flex items-center justify-center gap-2 touch-target shadow-md"
                data-track="call-menu-mobile"
              >
                Call: (940) 437-0550
              </a>
            </div>
          </div>
        </details>
      </div>

    </div>
  </div>
</header>
