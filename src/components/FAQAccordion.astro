---
interface FAQItem {
  question: string;
  answer: string;
}

interface Props {
  faqs?: FAQItem[];
  title?: string;
  subtitle?: string;
}

const defaultFaqs: FAQItem[] = [
  {
    question: "Does Infinilink Broadband have data caps or throttling?",
    answer: "No. Infinilink Broadband offers truly unlimited high-speed internet with zero data caps, zero overage fees, and no speed throttling. Fast is nice, steady is better: built so movies don't buffer and video calls don't freeze, even at 8 pm."
  },
  {
    question: "How does fixed wireless internet differ from satellite?",
    answer: "Fixed wireless transmits internet signals directly from local land-based towers to a small receiver on your roof. There is no dish to buy and no satellite lag. Because signals travel just a few miles instead of thousands of miles into space, you get steady speeds without weather delays."
  },
  {
    question: "What areas in Wise County does Infinilink service?",
    answer: "Infinilink provides high-speed wireless internet across Wise County, Texas, including Runaway Bay, Bridgeport, Decatur, Alvord, Paradise, and surrounding rural acreage."
  },
  {
    question: "Do I have to sign a long-term contract?",
    answer: "No. Infinilink operates month-to-month with no contracts and no surprise fees. One flat price every month. You can pay by check, by phone, or online through our customer portal."
  },
  {
    question: "Who owns and operates Infinilink Broadband?",
    answer: "Infinilink is a family-run local company founded in July 2016 by John Boyd, based in Runaway Bay. We live right here in Wise County and use Infinilink internet in our own homes every day."
  },
  {
    question: "What happens if I ever need support?",
    answer: "When something is wrong, you call a neighbor, not a chatbot. Most problems are solved within the hour, right over the phone or by text. Every install starts with a free line-of-sight check: if we can't give you a good connection, we'll tell you before you pay a dime."
  },
  {
    question: "Can I video call family and stream TV without buffering?",
    answer: "Yes! Video call the grandkids without the picture freezing. Our network is built on terrestrial wireless towers fed by three separate fiber lines, so if one line goes down, you stay online."
  },
  {
    question: "Do businesses pay more than homes?",
    answer: "No. Businesses get the exact same plans and prices as homes. We don't believe in the business markup."
  }
];

const { 
  faqs = defaultFaqs, 
  title = "Frequently Asked Questions", 
  subtitle = "Got questions about internet in Wise County? We have clear, honest answers."
} = Astro.props;

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(faq => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};
---

<section class="py-12">
  <div class="max-w-4xl mx-auto">
    <div class="text-center mb-10">
      <h2 class="text-3xl font-black text-slate-950 tracking-tight sm:text-4xl">{title}</h2>
      {subtitle && <p class="mt-3 text-base sm:text-lg text-slate-700 max-w-2xl mx-auto font-medium">{subtitle}</p>}
    </div>

    <div class="space-y-4">
      {faqs.map((faq, index) => (
        <details class="group bg-white border border-slate-200 rounded-xl overflow-hidden transition-all duration-200 hover:border-slate-300 shadow-xs" open={index === 0}>
          <summary class="flex justify-between items-center p-5 text-left font-bold text-slate-900 cursor-pointer select-none group-open:text-infinite-blue list-none">
            <span class="text-base sm:text-lg pr-4">{faq.question}</span>
            <span class="ml-2 w-7 h-7 rounded-full bg-slate-100 flex items-center justify-center text-slate-600 group-open:rotate-180 group-open:bg-blue-50 group-open:text-infinite-blue transition-transform duration-200 shrink-0">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
              </svg>
            </span>
          </summary>
          <div class="px-5 pb-5 text-slate-700 text-base leading-relaxed border-t border-slate-100 pt-3">
            <p>{faq.answer}</p>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<!-- High-Intent FAQPage Schema Injection -->
<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
