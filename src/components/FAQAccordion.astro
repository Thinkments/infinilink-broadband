---
interface FAQItem {
  question: string;
  answer: string;
}

interface Props {
  faqs?: FAQItem[];
  title?: string;
  subtitle?: string;
}

const defaultFaqs: FAQItem[] = [
  {
    question: "Does Infinilink Broadband have data caps or throttling?",
    answer: "No. Infinilink Broadband offers truly unlimited high-speed internet with zero data caps, zero overage fees, and no speed throttling regardless of how much data your household uses."
  },
  {
    question: "How does Fixed Wireless internet differ from satellite internet?",
    answer: "Fixed wireless transmits internet signals from local land-based towers directly to a small receiver on your home. Because the signal travels miles rather than thousands of miles into space, fixed wireless provides significantly lower latency (ping), higher reliability in storm conditions, and no satellite data limits."
  },
  {
    question: "What areas in Wise County does Infinilink service?",
    answer: "Infinilink proudly provides high-speed wireless internet across Wise County, Texas, including Decatur, Runaway Bay, Bridgeport, Alvord, Chico, Paradise, Boyd, and surrounding rural communities."
  },
  {
    question: "How fast does customer support respond for installs or issues?",
    answer: "Because Infinilink is locally owned and operated right here in Wise County, our team provides personal support and can respond the same day in most cases for installs, upgrades, and troubleshooting."
  },
  {
    question: "Is Infinilink suitable for online gaming and 4K streaming?",
    answer: "Yes. Our Plus and Premium plans are engineered with low latency specifically to support multiplayer online gaming, simultaneous 4K video streaming, home server hosting, and high-demand work-from-home video conferencing."
  }
];

const { 
  faqs = defaultFaqs, 
  title = "Frequently Asked Questions", 
  subtitle = "Got questions about fixed wireless broadband in Wise County? We have clear answers."
} = Astro.props;

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(faq => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};
---

<section class="py-12">
  <div class="max-w-4xl mx-auto">
    <div class="text-center mb-10">
      <h2 class="text-3xl font-black text-white tracking-tight sm:text-4xl">{title}</h2>
      {subtitle && <p class="mt-3 text-base text-slate-400 max-w-2xl mx-auto">{subtitle}</p>}
    </div>

    <div class="space-y-4">
      {faqs.map((faq, index) => (
        <details class="group bg-slate-900/80 border border-slate-800 rounded-xl overflow-hidden transition-all duration-200 hover:border-slate-700" open={index === 0}>
          <summary class="flex justify-between items-center p-5 text-left font-bold text-white cursor-pointer select-none group-open:text-cyan-400 list-none">
            <span class="text-base sm:text-lg pr-4">{faq.question}</span>
            <span class="ml-2 w-7 h-7 rounded-full bg-slate-800 flex items-center justify-center text-slate-300 group-open:rotate-180 group-open:bg-cyan-950 group-open:text-cyan-400 transition-transform duration-200 shrink-0">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
              </svg>
            </span>
          </summary>
          <div class="px-5 pb-5 text-slate-300 text-sm sm:text-base leading-relaxed border-t border-slate-800/60 pt-3">
            <p>{faq.answer}</p>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<!-- High-Intent FAQPage Schema Injection -->
<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
