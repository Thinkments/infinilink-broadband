---
interface Props {
  highlightedPlan?: string;
  showCommercialQuote?: boolean;
}

const { highlightedPlan = "plus", showCommercialQuote = true } = Astro.props;

// TODO: Plus and Premium typical speeds to be confirmed by John Boyd.
const plans = [
  {
    id: "starter",
    name: "Starter Plan",
    price: "$40",
    period: "/month",
    bestFor: "Great for 1–2 people. Streaming, email, video calls.",
    speedDisplay: "75–100 Mbps typical speed",
    speedNote: "Based on typical network performance.",
    features: [
      "Real speeds, not 'up to' speeds",
      "No data caps or overage charges",
      "No speed throttling, ever",
      "HD video streaming & crisp Zoom calls",
      "Month-to-month, no contracts",
      "Wi-Fi router support included",
    ],
    popular: false,
    ctaText: "Choose Starter ($40/mo)",
    ctaLink: "/#service-check",
  },
  {
    id: "plus",
    name: "Plus Plan",
    price: "$70",
    period: "/month",
    bestFor: "Busy homes. Several TVs, gaming, working from home.",
    speedDisplay: "[PLUS_SPEED] typical speed", // TODO: Plus Plan speed pending John's confirmation
    speedNote: "Fast & steady so video calls don't freeze.",
    features: [
      "Our most popular Wise County plan",
      "Truly unlimited data for the whole family",
      "Low lag for gaming & remote work",
      "Multiple simultaneous 4K streams",
      "No contracts or surprise fees",
      "Local support by phone or text",
    ],
    popular: true,
    ctaText: "Choose Plus ($70/mo)",
    ctaLink: "/#service-check",
  },
  {
    id: "premium",
    name: "Premium Plan",
    price: "$110",
    period: "/month",
    bestFor: "Big households and home offices. Everyone online at once.",
    speedDisplay: "[PREMIUM_SPEED] typical speed", // TODO: Premium Plan speed pending John's confirmation
    speedNote: "Built for heavy uploads, downloads & multiple users.",
    features: [
      "Maximum throughput from our local towers",
      "Smooth for everyone online at the same time",
      "Heavy cloud backups & large file transfers",
      "Zero buffering during peak evening hours",
      "No contracts or hidden equipment fees",
      "Neighbor-to-neighbor local support",
    ],
    popular: false,
    ctaText: "Choose Premium ($110/mo)",
    ctaLink: "/#service-check",
  },
];
---

<div class="w-full">
  <div class={`grid grid-cols-1 md:grid-cols-2 ${showCommercialQuote ? 'lg:grid-cols-4' : 'lg:grid-cols-3'} gap-6 sm:gap-8`}>
    {plans.map((plan) => {
      const isSelected = plan.id === highlightedPlan || plan.popular;
      return (
        <div class={`relative rounded-2xl flex flex-col justify-between transition-all duration-200 ${
          isSelected 
            ? 'bg-white border-3 border-[#0060B6] shadow-xl ring-1 ring-[#0060B6]/20' 
            : 'bg-white border-2 border-slate-200 hover:border-slate-300 shadow-sm'
        } p-6 sm:p-7`}>
          
          {plan.popular && (
            <div class="absolute -top-3.5 left-1/2 -translate-x-1/2 bg-[#0B1F3A] text-white text-xs font-black uppercase tracking-wider py-1 px-4 rounded-full border border-sky-400 shadow-sm">
              Most Popular in Wise County
            </div>
          )}

          <div>
            <!-- Header: What customer can DO first -->
            <div class="mb-4">
              <h3 class="text-2xl font-black text-[#0B1F3A]">{plan.name}</h3>
              <p class="text-base font-bold text-slate-800 mt-2 min-h-[48px] leading-snug">
                {plan.bestFor}
              </p>
            </div>

            <!-- Price -->
            <div class="py-4 border-y border-slate-100 mb-4">
              <div class="flex items-baseline">
                <span class="text-4xl sm:text-5xl font-black text-[#0B1F3A]">{plan.price}</span>
                <span class="text-slate-600 text-base font-bold ml-1.5">{plan.period}</span>
              </div>
              <!-- Speed clearly labeled as typical speeds (never guaranteed or up to) -->
              <div class="mt-2.5">
                <span class="inline-block bg-[#EBF4FC] text-[#0060B6] font-bold text-sm px-3 py-1 rounded-lg border border-[#0060B6]/20">
                  {plan.speedDisplay}
                </span>
                <p class="text-xs text-slate-600 mt-1">{plan.speedNote}</p>
              </div>
            </div>

            <!-- Features (At least 14px text) -->
            <ul class="space-y-3 mb-8 text-sm sm:text-base text-slate-700">
              {plan.features.map((feat) => (
                <li class="flex items-start gap-2.5">
                  <svg class="w-5 h-5 text-[#0060B6] shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path>
                  </svg>
                  <span>{feat}</span>
                </li>
              ))}
            </ul>
          </div>

          <div>
            <a 
              href={plan.ctaLink} 
              class={`w-full text-center block py-3.5 px-4 rounded-xl font-bold text-base transition-colors touch-target ${
                isSelected 
                  ? 'bg-[#0060B6] hover:bg-[#004D91] text-white shadow-md' 
                  : 'bg-slate-100 hover:bg-slate-200 text-[#0B1F3A] border border-slate-300'
              }`}
            >
              {plan.ctaText}
            </a>
          </div>

        </div>
      );
    })}

    {showCommercialQuote && (
      <div class="rounded-2xl flex flex-col justify-between bg-slate-50 border-2 border-dashed border-slate-300 p-6 sm:p-7 shadow-sm">
        <div>
          <div class="mb-4">
            <span class="text-xs font-bold text-slate-600 uppercase tracking-wider">Multi-Building / Ranch</span>
            <h3 class="text-2xl font-black text-[#0B1F3A] mt-1">Barns & Shops</h3>
            <p class="text-base font-bold text-slate-800 mt-2 min-h-[48px] leading-snug">
              Connect your guest house, workshop, barn, or separate office.
            </p>
          </div>

          <div class="py-4 border-y border-slate-200 mb-4">
            <span class="text-3xl font-black text-[#0B1F3A]">Custom Quote</span>
            <p class="text-xs text-slate-600 mt-2">Wireless point-to-point bridge between buildings on your property.</p>
          </div>

          <ul class="space-y-3 mb-8 text-sm sm:text-base text-slate-700">
            <li class="flex items-start gap-2.5">
              <svg class="w-5 h-5 text-[#0060B6] shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path>
              </svg>
              <span>Same flat monthly plans apply</span>
            </li>
            <li class="flex items-start gap-2.5">
              <svg class="w-5 h-5 text-[#0060B6] shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path>
              </svg>
              <span>No digging trenches or laying cables</span>
            </li>
            <li class="flex items-start gap-2.5">
              <svg class="w-5 h-5 text-[#0060B6] shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path>
              </svg>
              <span>Free site assessment by our local crew</span>
            </li>
          </ul>
        </div>

        <div>
          <a 
            href="/contact?plan=custom-building" 
            class="w-full text-center block py-3.5 px-4 rounded-xl font-bold text-base bg-white hover:bg-slate-100 text-[#0B1F3A] border-2 border-slate-300 transition-colors touch-target"
          >
            Request a Quote
          </a>
        </div>
      </div>
    )}
  </div>

  <!-- Mandatory Sub-Plan Statement -->
  <div class="mt-8 p-5 bg-[#EBF4FC] border-2 border-[#0060B6]/30 rounded-2xl text-center">
    <p class="text-base sm:text-lg font-black text-[#0B1F3A]">
      One flat price. No contracts. No data caps. No throttling. Same plans and prices for homes and businesses.
    </p>
    <p class="text-sm text-slate-700 font-medium mt-1">
      Every install starts with a free line-of-sight check. If we can't give you a good connection, we'll tell you before you pay a dime.
    </p>
  </div>
</div>
