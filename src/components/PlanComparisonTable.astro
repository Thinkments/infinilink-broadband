---
interface Props {
  highlightedPlan?: string;
}

const { highlightedPlan = "plus" } = Astro.props;

const plans = [
  {
    id: "starter",
    name: "Starter",
    price: "$50",
    period: "/month",
    description: "Ideal for light browsing, everyday email, social media, and smart home essentials.",
    target: "1 - 2 Devices",
    features: [
      "No Data Caps & No Throttling",
      "Low Latency Fixed Wireless",
      "Standard Web Browsing & HD Video",
      "Standard Wi-Fi Router Support",
      "Zero Annual Contracts",
      "Local Decatur Tech Support",
    ],
    popular: false,
    ctaText: "Choose Starter",
    ctaLink: "/#service-check",
  },
  {
    id: "plus",
    name: "Plus Plan",
    price: "$70",
    period: "/month",
    description: "Our most popular package for busy households streaming 4K and online multiplayer gaming.",
    target: "3 - 7 Devices",
    features: [
      "Truly Unlimited High-Speed Data",
      "Sub-30ms Low Latency Gaming Engine",
      "Simultaneous 4K Ultra-HD Streaming",
      "Optimized Zoom / Remote Work Uplink",
      "Whole-Home Wi-Fi Mesh Ready",
      "Priority Same-Day Wise County Dispatch",
      "No Equipment Rental Hidden Fees",
    ],
    popular: true,
    ctaText: "Get Plus Plan ($70/mo)",
    ctaLink: "/#service-check",
  },
  {
    id: "premium",
    name: "Premium Plan",
    price: "$110",
    period: "/month",
    description: "Maximum bandwidth and ultra-low ping for power users, creators, and large smart homes.",
    target: "8+ Devices & Heavy Usage",
    features: [
      "Maximum Available Wireless Throughput",
      "Dedicated Ultra-Low Ping Radio Channel",
      "Multiple Concurrent 4K/8K Streams",
      "Heavy Cloud Backups & Large File Transfers",
      "Whole-Home Wi-Fi Mesh Configuration",
      "VIP Local Dispatch & 24/7 Monitoring",
      "Zero Throttling Guaranteed",
    ],
    popular: false,
    ctaText: "Get Premium ($110/mo)",
    ctaLink: "/#service-check",
  },
  {
    id: "business",
    name: "Commercial / Business",
    price: "Custom",
    period: "SLA Tier",
    description: "Enterprise point-to-point dedicated wireless broadband for commercial operations and ranches.",
    target: "Offices, Retail & Agribusiness",
    features: [
      "Dedicated Symmetrical Speeds Available",
      "Static IP Address Included",
      "99.9% Network Uptime Guarantee",
      "Guaranteed Service Level Agreement (SLA)",
      "Priority 2-Hour Dispatch Protocol",
      "Custom Multi-Building Mesh Relays",
    ],
    popular: false,
    ctaText: "Contact Business Team",
    ctaLink: "/business-commercial-internet",
  },
];
---

<div class="w-full">
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
    {plans.map((plan) => {
      const isSelected = plan.id === highlightedPlan || plan.popular;
      return (
        <div class={`relative rounded-2xl flex flex-col justify-between transition-all duration-300 ${
          isSelected 
            ? 'bg-gradient-to-b from-slate-900 via-slate-900 to-blue-950/40 border-2 border-cyan-500 shadow-2xl shadow-cyan-500/10 scale-100 lg:-translate-y-2' 
            : 'bg-slate-900/80 border border-slate-800 hover:border-slate-700'
        } p-6 sm:p-8`}>
          
          {plan.popular && (
            <div class="absolute -top-4 left-1/2 -translate-x-1/2 bg-gradient-to-r from-blue-600 to-cyan-500 text-white text-xs font-black uppercase tracking-wider py-1 px-4 rounded-full shadow-md">
              Most Popular in Wise County
            </div>
          )}

          <div>
            <div class="flex justify-between items-baseline mb-3">
              <h3 class="text-xl font-bold text-white">{plan.name}</h3>
              <span class="text-xs text-cyan-400 font-semibold px-2 py-0.5 rounded bg-cyan-950/60 border border-cyan-900">{plan.target}</span>
            </div>

            <p class="text-slate-400 text-xs leading-relaxed mb-6 min-h-[40px]">{plan.description}</p>

            <div class="mb-6 pb-6 border-b border-slate-800">
              <div class="flex items-baseline">
                <span class="text-4xl font-extrabold text-white tracking-tight">{plan.price}</span>
                <span class="text-slate-400 text-sm ml-1.5">{plan.period}</span>
              </div>
              <p class="text-[11px] text-emerald-400 font-medium mt-1">✓ Transparent billing • No hidden fees</p>
            </div>

            <ul class="space-y-3 mb-8 text-xs text-slate-300">
              {plan.features.map((feat) => (
                <li class="flex items-start gap-2.5">
                  <svg class="w-4 h-4 text-cyan-400 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path>
                  </svg>
                  <span>{feat}</span>
                </li>
              ))}
            </ul>
          </div>

          <div>
            <a 
              href={plan.ctaLink} 
              class={`w-full text-center block py-3 px-4 rounded-xl font-bold text-sm transition-all duration-200 ${
                isSelected 
                  ? 'bg-gradient-to-r from-blue-600 to-cyan-600 hover:from-blue-500 hover:to-cyan-500 text-white shadow-lg shadow-cyan-500/20' 
                  : 'bg-slate-800 hover:bg-slate-700 text-white border border-slate-700'
              }`}
            >
              {plan.ctaText}
            </a>
          </div>

        </div>
      );
    })}
  </div>

  <div class="mt-8 p-4 bg-slate-900/60 border border-slate-800 rounded-xl flex flex-col sm:flex-row items-center justify-between text-xs text-slate-400 gap-4">
    <div class="flex items-center gap-2">
      <span class="text-emerald-400 font-bold text-base">★</span>
      <span><strong>Zero Throttling Guarantee:</strong> We never slow down your connection based on data usage.</span>
    </div>
    <div class="flex items-center gap-2">
      <span class="text-cyan-400 font-bold text-base">★</span>
      <span><strong>Professional Installation:</strong> Outdoor line-of-sight antenna + indoor POE injector included.</span>
    </div>
  </div>
</div>
