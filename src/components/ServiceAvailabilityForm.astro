---
interface Props {
  title?: string;
  subtitle?: string;
  className?: string;
}

const { 
  title = "Check Service Availability at Your Address", 
  subtitle = "Enter your Wise County location to verify immediate fixed wireless line-of-sight & tower speeds.",
  className = "" 
} = Astro.props;
---

<div class={`bg-slate-900/90 backdrop-blur-md p-6 sm:p-8 rounded-2xl border border-slate-800 shadow-2xl ${className}`}>
  {title && <h3 class="text-2xl font-bold text-white mb-2">{title}</h3>}
  {subtitle && <p class="text-slate-400 text-sm mb-6">{subtitle}</p>}

  <form 
    id="service-availability-form"
    name="service-check" 
    method="POST" 
    data-netlify="true" 
    netlify-honeypot="bot-field" 
    action="/contact?status=success"
    onsubmit="if(window.trackInfinilinkConversion) { window.trackInfinilinkConversion('lead', { formName: 'Address Coverage Check' }); }"
    class="space-y-4"
  >
    <input type="hidden" name="form-name" value="service-check" />
    <p class="hidden">
      <label>Do not fill: <input name="bot-field" /></label>
    </p>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div>
        <label for="name" class="block text-sm font-medium text-slate-300 mb-1">Full Name</label>
        <input 
          type="text" 
          id="name" 
          name="name" 
          required 
          placeholder="e.g., John Miller"
          class="w-full bg-slate-800/80 border border-slate-700 text-white rounded-lg px-4 py-3 focus:outline-none focus:ring-2 focus:ring-blue-500 placeholder-slate-500 transition" 
        />
      </div>
      <div>
        <label for="phone" class="block text-sm font-medium text-slate-300 mb-1">Phone Number</label>
        <input 
          type="tel" 
          id="phone" 
          name="phone" 
          required 
          placeholder="(940) 555-0199"
          class="w-full bg-slate-800/80 border border-slate-700 text-white rounded-lg px-4 py-3 focus:outline-none focus:ring-2 focus:ring-blue-500 placeholder-slate-500 transition" 
        />
      </div>
    </div>

    <div>
      <label for="address" class="block text-sm font-medium text-slate-300 mb-1">Service Street Address (Wise County, TX)</label>
      <input 
        type="text" 
        id="address" 
        name="address" 
        required 
        placeholder="e.g., 1234 CR 1110, Decatur, TX 76234" 
        class="w-full bg-slate-800/80 border border-slate-700 text-white rounded-lg px-4 py-3 focus:outline-none focus:ring-2 focus:ring-blue-500 placeholder-slate-500 transition" 
      />
    </div>

    <div>
      <label for="plan_interest" class="block text-sm font-medium text-slate-300 mb-1">Plan of Interest</label>
      <select 
        id="plan_interest" 
        name="plan_interest" 
        class="w-full bg-slate-800/80 border border-slate-700 text-white rounded-lg px-4 py-3 focus:outline-none focus:ring-2 focus:ring-blue-500 transition"
      >
        <option value="plus">Plus Plan - $70/mo (Most Popular - Streaming & Gaming)</option>
        <option value="starter">Starter Plan (Web Browsing, Email & Work)</option>
        <option value="premium">Premium Plan - $110/mo (Heavy Multi-Device 4K & Cloud)</option>
        <option value="business">Commercial / Dedicated Business High-Speed</option>
      </select>
    </div>

    <button 
      type="submit" 
      class="w-full bg-gradient-to-r from-blue-600 to-cyan-600 hover:from-blue-500 hover:to-cyan-500 text-white font-bold py-3.5 px-6 rounded-lg shadow-lg hover:shadow-cyan-500/25 transition duration-200 transform active:scale-[0.99] flex items-center justify-center space-x-2"
    >
      <span>Check Address Availability</span>
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
      </svg>
    </button>
    
    <p class="text-xs text-slate-500 text-center mt-2 flex items-center justify-center gap-1.5">
      <svg class="w-4 h-4 text-emerald-400 inline" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
      </svg>
      Same-day dispatch & line-of-sight checks across Wise County. No spam, ever.
    </p>
  </form>
</div>
