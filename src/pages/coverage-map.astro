---
import BaseLayout from '../layouts/BaseLayout.astro';
import ServiceAvailabilityForm from '../components/ServiceAvailabilityForm.astro';

const serviceAreas = [
  { name: 'Decatur, TX', href: '/service-areas/high-speed-internet-decatur-tx', desc: 'Central Wise County hub with full residential & commercial tower coverage.' },
  { name: 'Runaway Bay, TX', href: '/service-areas/internet-provider-runaway-bay-tx', desc: 'Lake Bridgeport waterfront & surrounding neighborhoods.' },
  { name: 'Bridgeport, TX', href: '/service-areas/rural-internet-bridgeport-tx', desc: 'Agricultural land, ranches, and residential communities.' },
  { name: 'Alvord, TX', href: '/service-areas/high-speed-internet-alvord-tx', desc: 'North Wise County line-of-sight wireless coverage.' },
  { name: 'Paradise, TX', href: '/service-areas/internet-service-paradise-tx', desc: 'South Wise County high-speed fixed wireless broadband.' },
];
---

<BaseLayout 
  title="Coverage Map & Service Inquiry | Wise County TX" 
  description="Check your address for Infinilink Broadband coverage across Decatur, Runaway Bay, Bridgeport, and Wise County, Texas."
>
  <div class="py-16 sm:py-24 bg-slate-950 text-slate-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-3xl mx-auto mb-16">
        <span class="inline-flex items-center px-3.5 py-1.5 rounded-full text-xs font-semibold bg-cyan-950 text-cyan-400 border border-cyan-800 uppercase tracking-wider mb-4">
          Wise County Coverage
        </span>
        <h1 class="text-4xl sm:text-5xl font-black text-white tracking-tight mb-4">
          Let Us Help Set You Up With the Best Internet!
        </h1>
        <p class="text-lg text-slate-300">
          Enter your physical address below. Our local Wise County team will run an immediate line-of-sight elevation analysis and contact you with available speeds.
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start max-w-6xl mx-auto">
        <!-- Lead Capture Form -->
        <div class="lg:col-span-7">
          <ServiceAvailabilityForm 
            title="Check Your Address Coverage" 
            subtitle="Fast verification by local technicians in Decatur & Runaway Bay, TX."
          />
        </div>

        <!-- Coverage Details & Community Links -->
        <div class="lg:col-span-5 space-y-6">
          <div class="bg-slate-900 border border-slate-800 p-6 sm:p-8 rounded-2xl">
            <h2 class="text-xl font-bold text-white mb-4">Our Service Reach</h2>
            <p class="text-sm text-slate-300 mb-6 leading-relaxed">
              We proudly provide high-speed, truly unlimited fixed wireless internet across Wise County, TX. Because we broadcast from local terrestrial towers, our signal reaches rural properties, ranches, and acreage where cable and fiber do not go.
            </p>

            <h3 class="text-xs font-bold text-cyan-400 uppercase tracking-wider mb-3">Key Coverage Hubs:</h3>
            <ul class="space-y-3">
              {serviceAreas.map(area => (
                <li>
                  <a href={area.href} class="group block p-3 rounded-xl bg-slate-950/60 border border-slate-800 hover:border-cyan-500 transition">
                    <div class="flex items-center justify-between">
                      <span class="font-bold text-white text-sm group-hover:text-cyan-400 transition">{area.name}</span>
                      <span class="text-xs text-cyan-400">View Coverage →</span>
                    </div>
                    <p class="text-xs text-slate-400 mt-1">{area.desc}</p>
                  </a>
                </li>
              ))}
            </ul>
          </div>

          <div class="bg-slate-900/60 border border-slate-800 p-6 rounded-2xl flex items-center justify-between">
            <div>
              <p class="text-xs text-slate-400">Prefer to speak with someone?</p>
              <a href="tel:9404370550" class="text-xl font-black text-cyan-400 hover:text-cyan-300">
                (940) 437-0550
              </a>
            </div>
            <a 
              href="https://billing.infinilinkbroadband.com" 
              class="text-xs font-semibold px-4 py-2 rounded-lg bg-slate-800 text-slate-200 hover:bg-slate-700 transition"
              target="_blank"
              rel="noopener noreferrer"
            >
              Customer Portal →
            </a>
          </div>
        </div>
      </div>

    </div>
  </div>
</BaseLayout>
