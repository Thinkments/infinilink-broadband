---
// TODO: Static IP add-on: confirm with John before listing.
import BaseLayout from '../layouts/BaseLayout.astro';
import PlanComparisonTable from '../components/PlanComparisonTable.astro';
import ServiceAvailabilityForm from '../components/ServiceAvailabilityForm.astro';
import FAQAccordion from '../components/FAQAccordion.astro';

const businessFaqs = [
  {
    question: "Do businesses pay more?",
    answer: "No. Businesses get the same plans and prices as homes. We don't believe in charging local shops, offices, or ranches an artificial markup just because you run a business."
  },
  {
    question: "Are there long-term contracts for businesses?",
    answer: "No. All plans are month-to-month. You are never locked into a multi-year contract or hit with cancellation fees."
  },
  {
    question: "How fast can you help if our business internet has an issue?",
    answer: "Most problems are solved within the hour, by phone or text. Because we live and work right here in Wise County, you talk directly with our local crew, not a faraway support queue."
  },
  {
    question: "Can Infinilink connect multiple ranch buildings, workshops, or barns?",
    answer: "Yes! We can set up point-to-point wireless bridges between your main office, workshop, barn, or guest quarters without trenching wires. Request a quote and we'll evaluate your property."
  }
];
---

<BaseLayout 
  title="Local Business Internet for Wise County | Same Honest Pricing" 
  description="Business internet without the business markup. Same plans, same prices, same local crew. No contracts across Decatur, Runaway Bay, Bridgeport, and Wise County."
>
  <div class="py-16 sm:py-24 bg-white text-slate-900">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Page Hero -->
      <div class="text-center max-w-4xl mx-auto mb-16">
        <span class="inline-flex items-center px-4 py-1.5 rounded-full text-sm font-bold bg-[#EBF4FC] text-[#0060B6] border border-[#0060B6]/30 uppercase tracking-wider mb-4">
          Fair Business Internet
        </span>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black text-[#0B1F3A] tracking-tight mb-4">
          Local Business Internet for Wise County, Same Honest Pricing
        </h1>
        <p class="text-xl sm:text-2xl text-slate-700 font-medium max-w-3xl mx-auto leading-relaxed">
          Business internet without the business markup. Same plans, same prices, same local crew. No contracts.
        </p>
      </div>

      <!-- 4 Core Business Feature Cards -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 sm:gap-8 mb-20">
        
        <div class="bg-slate-50 border-2 border-slate-200 p-8 rounded-2xl space-y-3 shadow-sm">
          <div class="w-12 h-12 rounded-xl bg-[#EBF4FC] text-[#0060B6] flex items-center justify-center mb-4">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
            </svg>
          </div>
          <h2 class="text-xl font-black text-[#0B1F3A]">No Data Caps or Throttling</h2>
          <p class="text-base text-slate-700 font-medium leading-relaxed">
            Run point-of-sale systems, upload bookkeeping files, process card payments, and stream background music without ever worrying about overage charges.
          </p>
        </div>

        <div class="bg-slate-50 border-2 border-slate-200 p-8 rounded-2xl space-y-3 shadow-sm">
          <div class="w-12 h-12 rounded-xl bg-[#EBF4FC] text-[#0060B6] flex items-center justify-center mb-4">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
          </div>
          <h2 class="text-xl font-black text-[#0B1F3A]">No Contracts</h2>
          <p class="text-base text-slate-700 font-medium leading-relaxed">
            Every business plan is month-to-month. We earn your business every 30 days. No long-term lock-in, no termination penalties, and no hidden fine print.
          </p>
        </div>

        <div class="bg-slate-50 border-2 border-slate-200 p-8 rounded-2xl space-y-3 shadow-sm">
          <div class="w-12 h-12 rounded-xl bg-[#EBF4FC] text-[#0060B6] flex items-center justify-center mb-4">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
            </svg>
          </div>
          <h2 class="text-xl font-black text-[#0B1F3A]">Local Support: Real People</h2>
          <p class="text-base text-slate-700 font-medium leading-relaxed">
            Real people answer your call or text. Most problems are solved within the hour, by phone or text. If an on-site visit is needed, we are right down the road.
          </p>
        </div>

        <div class="bg-[#0B1F3A] text-white p-8 rounded-2xl space-y-3 shadow-md flex flex-col justify-between">
          <div>
            <span class="inline-block px-2.5 py-1 rounded bg-[#162E52] text-sky-300 text-xs font-bold uppercase tracking-wider mb-2">Request a Quote</span>
            <h2 class="text-xl font-black text-white">Barns, Shops & Outbuildings</h2>
            <p class="text-sm text-slate-200 font-normal leading-relaxed mt-2">
              Need internet in your detached workshop, barn, storage facility, or separate guest house? Ask us about connecting multiple buildings on your property.
            </p>
          </div>
          <div class="pt-4">
            <a 
              href="/contact?plan=multi-building" 
              class="inline-block w-full text-center bg-white hover:bg-slate-100 text-[#0B1F3A] font-bold text-sm py-2.5 px-4 rounded-xl transition touch-target"
            >
              Request a Custom Quote →
            </a>
          </div>
        </div>

      </div>

      <!-- Business Plans Grid -->
      <section class="mb-20" aria-labelledby="business-plans-heading">
        <div class="text-center max-w-3xl mx-auto mb-10">
          <h2 id="business-plans-heading" class="text-3xl sm:text-4xl font-black text-[#0B1F3A]">
            Transparent Pricing for Wise County Businesses
          </h2>
          <p class="text-slate-600 text-lg mt-2 font-medium">
            Same flat rates whether you're connecting a family home, retail storefront, or ranch office.
          </p>
        </div>
        <PlanComparisonTable highlightedPlan="plus" showCommercialQuote={false} />
      </section>

      <!-- Network Track Record Callout -->
      <div class="bg-[#0B1F3A] text-white p-8 sm:p-10 rounded-3xl mb-20 flex flex-col md:flex-row items-center justify-between gap-6 shadow-md">
        <div class="space-y-2 text-center md:text-left">
          <span class="text-sky-300 font-bold text-sm uppercase tracking-wider">Independent Live Verification</span>
          <h2 class="text-2xl sm:text-3xl font-black text-white">100% Uptime Over the Last 90 Days</h2>
          <p class="text-slate-200 text-base max-w-2xl font-medium">
            Three separate fiber lines feed our network, so if one provider has a line cut, your business stays online. Check our live status anytime.
          </p>
        </div>
        <a 
          href="https://status.infinilinkbroadband.com" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="bg-[#0060B6] hover:bg-[#004D91] text-white font-bold text-base px-6 py-3.5 rounded-xl transition shrink-0 touch-target border border-sky-400/40 shadow-sm"
        >
          View Live Status Page →
        </a>
      </div>

      <!-- Lead Capture Form -->
      <div class="max-w-3xl mx-auto mb-20" id="business-check">
        <ServiceAvailabilityForm 
          title="Check Business Address Availability"
          subtitle="Enter your location below. Our local crew will perform a free line-of-sight check."
        />
      </div>

      <!-- Commercial FAQs -->
      <FAQAccordion 
        faqs={businessFaqs} 
        title="Wise County Business Internet FAQs" 
        subtitle="Clear answers for local business owners and ranch managers."
      />

    </div>
  </div>
</BaseLayout>
