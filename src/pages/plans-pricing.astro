---
import BaseLayout from '../layouts/BaseLayout.astro';
import PlanComparisonTable from '../components/PlanComparisonTable.astro';
import ServiceAvailabilityForm from '../components/ServiceAvailabilityForm.astro';
import FAQAccordion from '../components/FAQAccordion.astro';
---

<BaseLayout 
  title="Internet Plans & Pricing | Infinilink Broadband Wise County TX" 
  description="Explore transparent fixed wireless internet plans from $40/mo to $110/mo. Truly unlimited data, zero caps, no contracts, and local Wise County support."
>
  <div class="py-16 sm:py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Page Header -->
      <div class="text-center max-w-3xl mx-auto mb-16">
        <span class="inline-flex items-center px-4 py-1.5 rounded-full text-sm font-bold bg-blue-50 text-navy-900 border border-blue-200 uppercase tracking-wider mb-4">
          Simple, Honest Pricing
        </span>
        <h1 class="text-4xl sm:text-5xl font-black text-navy-950 tracking-tight mb-4">
          Wise County Internet Plans <br class="hidden sm:inline" />With Zero Hidden Fees
        </h1>
        <p class="text-lg text-slate-700 font-medium">
          Choose the speed that fits your home or business. Real speeds, not "up to" speeds. Every plan includes truly unlimited data, steady connections without satellite lag, and zero throttling.
        </p>
      </div>

      <!-- Plan Comparison Table with Visible H2 -->
      <div class="mb-20">
        <h2 class="text-2xl sm:text-3xl font-black text-navy-950 text-center mb-8">
          Compare Our Internet Plans
        </h2>
        <PlanComparisonTable highlightedPlan="plus" />
      </div>

      <!-- Transparent Breakdown Section -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-20">
        
        <div class="bg-slate-50 border border-slate-200 p-8 rounded-2xl shadow-xs">
          <div class="w-10 h-10 rounded-xl bg-blue-100 text-infinite-blue font-bold text-lg mb-4 flex items-center justify-center border border-blue-200">
            01
          </div>
          <h2 class="text-xl font-bold text-navy-950 mb-2">Zero Data Caps</h2>
          <p class="text-base text-slate-700 leading-relaxed font-normal">
            No data caps or throttling. Infinilink provides unlimited data 24/7/365 with zero penalties or overage surprises on your bill.
          </p>
        </div>

        <div class="bg-slate-50 border border-slate-200 p-8 rounded-2xl shadow-xs">
          <div class="w-10 h-10 rounded-xl bg-blue-100 text-infinite-blue font-bold text-lg mb-4 flex items-center justify-center border border-blue-200">
            02
          </div>
          <h2 class="text-xl font-bold text-navy-950 mb-2">No Contracts</h2>
          <p class="text-base text-slate-700 leading-relaxed font-normal">
            We believe in earning your business every single month. All broadband plans are 100% month-to-month. Cancel anytime without fees.
          </p>
        </div>

        <div class="bg-slate-50 border border-slate-200 p-8 rounded-2xl shadow-xs">
          <div class="w-10 h-10 rounded-xl bg-blue-100 text-infinite-blue font-bold text-lg mb-4 flex items-center justify-center border border-blue-200">
            03
          </div>
          <h2 class="text-xl font-bold text-navy-950 mb-2">We Handle the Setup</h2>
          <p class="text-base text-slate-700 leading-relaxed font-normal">
            We do it all: the antenna, the router, and your Wi-Fi. Free line-of-sight check before you pay a dime. No tech talk required.
          </p>
        </div>

      </div>

      <!-- Lead Capture Form -->
      <div class="max-w-3xl mx-auto mb-20" id="service-check">
        <ServiceAvailabilityForm 
          title="Sign Up or Check Address Coverage"
          subtitle="Enter your address below. Our local team will verify signal strength and confirm your install schedule."
        />
      </div>

      <!-- FAQ -->
      <FAQAccordion />

    </div>
  </div>
</BaseLayout>
