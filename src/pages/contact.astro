---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="Contact Local Tech Support & Office | Infinilink Broadband Wise County TX" 
  description="Contact Infinilink Broadband in Runaway Bay, TX. Call (940) 437-0550 for local support, address availability checks, or plan questions."
>
  <div class="py-16 sm:py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Header -->
      <div class="text-center max-w-3xl mx-auto mb-16">
        <span class="inline-flex items-center px-4 py-1.5 rounded-full text-sm font-bold bg-blue-50 text-navy-900 border border-blue-200 uppercase tracking-wider mb-4">
          Local Wise County Team
        </span>
        <h1 class="text-4xl sm:text-5xl font-black text-navy-950 tracking-tight mb-4">
          Speak with a Real Person
        </h1>
        <p class="text-lg sm:text-xl text-slate-700 font-normal">
          No automated phone trees or overseas call centers. When something's wrong, you call a neighbor, not a chatbot. We're right here in Runaway Bay.
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
        
        <!-- Contact Information Cards -->
        <div class="lg:col-span-5 space-y-6">
          
          <div class="bg-slate-50 border border-slate-200 p-8 rounded-2xl space-y-4 shadow-xs">
            <h2 class="text-2xl font-bold text-navy-950">Call or Text Our Office</h2>
            <p class="text-base text-slate-700 font-normal">
              Call us directly for honest answers regarding service availability, speeds, or technical questions.
            </p>
            <div class="pt-2">
              <a 
                href="tel:+19404370550" 
                class="inline-flex items-center text-2xl sm:text-3xl font-black text-infinite-blue hover:text-infinite-blue-dark transition"
                aria-label="Call Infinilink Broadband at 940-437-0550"
                data-track="call-contact"
              >
                <svg class="w-7 h-7 mr-3 text-infinite-blue" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
                </svg>
                (940) 437-0550
              </a>
            </div>
            <p class="text-sm text-slate-700 font-medium leading-relaxed">
              Monday – Friday: 8:00 AM – 6:00 PM CST<br />
              Saturday: 9:00 AM – 2:00 PM CST • Emergency Monitoring 24/7
            </p>
          </div>

          <div class="bg-slate-50 border border-slate-200 p-8 rounded-2xl space-y-4 shadow-xs">
            <h2 class="text-2xl font-bold text-navy-950">Mailing Address & Office</h2>
            <div class="text-base text-slate-700 space-y-1">
              <p class="font-bold text-navy-950">Infinilink Broadband</p>
              <p>101 Cooper Ct</p>
              <p>Runaway Bay, TX 76426</p>
              <div class="pt-2 text-sm text-slate-700 space-y-1">
                <p><strong>Support:</strong> Most problems solved within the hour, by phone or text.</p>
                <p><strong>Email:</strong> <a href="mailto:support@infinilinkbroadband.com" class="text-infinite-blue font-bold hover:underline">support@infinilinkbroadband.com</a></p>
              </div>
            </div>
            <div class="pt-2 border-t border-slate-200 flex items-center gap-3">
              <a 
                href="https://www.facebook.com/infinilinkbroadband" 
                target="_blank" 
                rel="noopener noreferrer" 
                class="inline-flex items-center gap-1.5 text-sm font-semibold text-infinite-blue hover:underline"
              >
                <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
                </svg>
                Follow on Facebook
              </a>
              <span class="text-slate-300">•</span>
              <a 
                href="https://www.google.com/maps/place/Infinilink+Broadband/@33.1709744,-97.8963515,4580m/data=!3m1!1e3!4m6!3m5!1s0x86520cc4281a4471:0x9bec41ac337c3c1a!8m2!3d33.173094!4d-97.8998028!16s%2Fg%2F11c3x99zby?entry=ttu" 
                target="_blank" 
                rel="noopener noreferrer" 
                class="inline-flex items-center gap-1.5 text-sm font-semibold text-red-700 hover:underline"
              >
                Google Maps
              </a>
            </div>
          </div>

          <div class="bg-blue-50 border border-blue-200 p-6 rounded-2xl shadow-xs space-y-3">
            <div class="flex items-center gap-2">
              <svg class="w-5 h-5 text-infinite-blue" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
              </svg>
              <h3 class="text-lg font-bold text-navy-950">Customer Billing Portal</h3>
            </div>
            <p class="text-sm text-slate-700 font-normal">
              Need to pay your monthly bill, view previous invoices, or update your payment card?
            </p>
            <a 
              href="https://billing.infinilinkbroadband.com" 
              class="inline-flex items-center justify-center w-full bg-navy-900 hover:bg-navy-950 text-white font-bold py-3 px-4 rounded-xl text-sm transition min-h-[44px]"
            >
              Sign In to Customer Billing Portal →
            </a>
          </div>

          <div class="bg-slate-50 border border-slate-200 p-6 rounded-2xl shadow-xs">
            <div class="flex items-center gap-3">
              <span class="w-3 h-3 rounded-full bg-emerald-600 inline-block" aria-hidden="true"></span>
              <span class="text-base font-bold text-navy-950">Free Line-of-Sight Check</span>
            </div>
            <p class="text-sm text-slate-700 font-normal mt-2 leading-relaxed">
              Every install starts with a free line-of-sight check. If we can't give you a good connection, we'll tell you before you pay a dime.
            </p>
          </div>

        </div>

        <!-- Netlify Contact Form -->
        <div class="lg:col-span-7 bg-white border border-slate-200 p-8 sm:p-10 rounded-2xl shadow-md">
          <!-- Accessible Live Region for Form Status -->
          <div 
            id="form-status-region" 
            aria-live="polite" 
            class="mb-6 p-4 rounded-xl hidden bg-emerald-50 border border-emerald-300 text-emerald-950"
          >
            <div class="flex items-center space-x-3">
              <svg class="w-6 h-6 text-emerald-700 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
              <div>
                <p class="font-bold text-emerald-950 text-base">Thank you! Your message has been sent.</p>
                <p class="text-sm text-emerald-900 font-medium">Our local Wise County team will follow up with you promptly.</p>
              </div>
            </div>
          </div>

          <h2 class="text-2xl sm:text-3xl font-black text-navy-950 mb-2">Send an Inquiry or Message</h2>
          <p class="text-base text-slate-700 mb-6 font-normal">Fill out the details below and we will get back to you shortly.</p>

          <form 
            id="infinilink-contact-form"
            name="contact-form" 
            method="POST" 
            data-netlify="true" 
            netlify-honeypot="bot-field" 
            action="/contact?status=success"
            data-track="form-contact"
            class="space-y-5"
          >
            <input type="hidden" name="form-name" value="contact-form" />
            <input type="hidden" name="lead_source" id="contact-lead-source" value="" />
            <p class="hidden">
              <label for="contact-bot-field" class="sr-only">Do not fill if human</label>
              <input id="contact-bot-field" name="bot-field" tabindex="-1" autocomplete="off" />
            </p>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="contact-name" class="block text-base font-bold text-navy-950 mb-1.5">Full Name</label>
                <input 
                  type="text" 
                  id="contact-name" 
                  name="name" 
                  required 
                  autocomplete="name"
                  placeholder="John Doe" 
                  class="w-full bg-slate-50 border-2 border-slate-300 text-slate-900 rounded-lg px-4 py-3 focus:outline-none focus:border-infinite-blue focus:bg-white text-base font-medium transition" 
                />
              </div>
              <div>
                <label for="contact-phone" class="block text-base font-bold text-navy-950 mb-1.5">Phone Number</label>
                <input 
                  type="tel" 
                  id="contact-phone" 
                  name="phone" 
                  required 
                  autocomplete="tel"
                  placeholder="(940) 555-0100" 
                  class="w-full bg-slate-50 border-2 border-slate-300 text-slate-900 rounded-lg px-4 py-3 focus:outline-none focus:border-infinite-blue focus:bg-white text-base font-medium transition" 
                />
              </div>
            </div>

            <div>
              <label for="contact-email" class="block text-base font-bold text-navy-950 mb-1.5">Email Address</label>
              <input 
                type="email" 
                id="contact-email" 
                name="email" 
                required 
                autocomplete="email"
                placeholder="john@example.com" 
                class="w-full bg-slate-50 border-2 border-slate-300 text-slate-900 rounded-lg px-4 py-3 focus:outline-none focus:border-infinite-blue focus:bg-white text-base font-medium transition" 
              />
            </div>

            <div>
              <label for="contact-subject" class="block text-base font-bold text-navy-950 mb-1.5">Subject / Inquiry Type</label>
              <select 
                id="contact-subject" 
                name="subject" 
                class="w-full bg-slate-50 border-2 border-slate-300 text-slate-900 rounded-lg px-4 py-3 focus:outline-none focus:border-infinite-blue focus:bg-white text-base font-medium transition"
              >
                <option value="new-service">New Home Internet Inquiry</option>
                <option value="business-service">Business Internet Inquiry</option>
                <option value="support">Technical Support</option>
                <option value="billing">Billing & Account Inquiry</option>
              </select>
            </div>

            <div>
              <label for="contact-message" class="block text-base font-bold text-navy-950 mb-1.5">Street Address or Message Details</label>
              <textarea 
                id="contact-message" 
                name="message" 
                rows="4" 
                required 
                placeholder="Please include your Wise County street address if inquiring about new service..."
                class="w-full bg-slate-50 border-2 border-slate-300 text-slate-900 rounded-lg px-4 py-3 focus:outline-none focus:border-infinite-blue focus:bg-white text-base font-medium transition"
              ></textarea>
            </div>

            <button 
              type="submit" 
              class="w-full bg-infinite-blue hover:bg-infinite-blue-dark text-white font-bold py-4 rounded-xl shadow-xs transition duration-200 text-lg min-h-[48px]"
            >
              Submit Message
            </button>
          </form>
        </div>

      </div>

    </div>
  </div>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', function() {
      // Capture UTM / lead source
      var params = new URLSearchParams(window.location.search);
      var leadSourceInput = document.getElementById('contact-lead-source');
      if (leadSourceInput) {
        var source = params.get('utm_source') || params.get('source') || '';
        var campaign = params.get('utm_campaign') || '';
        if (source || campaign) {
          leadSourceInput.value = 'source=' + source + ';campaign=' + campaign;
        }
      }

      // Check success query param
      if (params.get('status') === 'success') {
        var statusRegion = document.getElementById('form-status-region');
        if (statusRegion) {
          statusRegion.classList.remove('hidden');
          statusRegion.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
      }
    });
  </script>
</BaseLayout>
