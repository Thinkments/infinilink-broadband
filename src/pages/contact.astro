---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="Contact Local Tech Support & Sales | Decatur Wise County TX" 
  description="Contact Infinilink Broadband in Decatur, TX. Call (940) 437-0550 for fast local technical support, new service availability, or commercial site surveys."
>
  <div class="py-16 sm:py-24 bg-slate-950">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Header -->
      <div class="text-center max-w-3xl mx-auto mb-16">
        <span class="inline-flex items-center px-3.5 py-1.5 rounded-full text-xs font-semibold bg-cyan-950 text-cyan-400 border border-cyan-800 uppercase tracking-wider mb-4">
          Local Decatur Operations
        </span>
        <h1 class="text-4xl sm:text-5xl font-black text-white tracking-tight mb-4">
          Speak with a Wise County Local
        </h1>
        <p class="text-lg text-slate-300">
          No automated phone trees or overseas call centers. Whether you're checking address availability, requesting tech support, or setting up commercial broadband, we’re right down the road.
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
        
        <!-- Contact Information Cards -->
        <div class="lg:col-span-5 space-y-6">
          
          <div class="bg-slate-900 border border-slate-800 p-8 rounded-2xl space-y-4">
            <h2 class="text-xl font-bold text-white">Direct Phone Dispatch</h2>
            <p class="text-sm text-slate-400">
              Call us directly for instant answers regarding coverage, speeds, and scheduling.
            </p>
            <div class="pt-2">
              <a 
                href="tel:9404370550" 
                class="inline-flex items-center text-2xl font-black text-cyan-400 hover:text-cyan-300 transition"
              >
                <svg class="w-6 h-6 mr-3 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
                </svg>
                (940) 437-0550
              </a>
            </div>
            <p class="text-xs text-slate-500">
              Monday – Friday: 8:00 AM – 6:00 PM CST<br />
              Saturday: 9:00 AM – 2:00 PM CST • Emergency Monitoring 24/7
            </p>
          </div>

          <div class="bg-slate-900 border border-slate-800 p-8 rounded-2xl space-y-3">
            <h2 class="text-xl font-bold text-white">Wise County Headquarters</h2>
            <div class="text-sm text-slate-300 space-y-1">
              <p class="font-semibold text-white">Infinilink Broadband</p>
              <p>Decatur, Texas 76234</p>
              <p class="text-xs text-slate-400">Serving Decatur, Runaway Bay, Bridgeport, Alvord, Chico, Paradise, Boyd & all Wise County ranches.</p>
            </div>
          </div>

          <div class="bg-slate-900/60 border border-slate-800/80 p-6 rounded-2xl">
            <div class="flex items-center gap-3">
              <span class="w-3 h-3 rounded-full bg-emerald-400 animate-pulse"></span>
              <span class="text-sm font-semibold text-white">Same-Day Tech Dispatch Active</span>
            </div>
            <p class="text-xs text-slate-400 mt-2">
              Our field service vehicles are stocked with high-gain transceivers, POE units, and Wi-Fi 6 mesh hardware for rapid on-site resolution.
            </p>
          </div>

        </div>

        <!-- Netlify Contact Form -->
        <div class="lg:col-span-7 bg-slate-900 border border-slate-800 p-8 sm:p-10 rounded-2xl shadow-2xl">
          <!-- Success Notification Banner -->
          <div id="success-banner" class="hidden mb-6 p-4 rounded-xl bg-emerald-950/80 border border-emerald-500/40 text-emerald-200">
            <div class="flex items-center space-x-3">
              <svg class="w-6 h-6 text-emerald-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
              <div>
                <p class="font-bold text-white">Thank you! Your inquiry has been received.</p>
                <p class="text-xs text-emerald-300">A local Wise County technician or representative will contact you shortly.</p>
              </div>
            </div>
          </div>

          <h2 class="text-2xl font-bold text-white mb-2">Send an Inquiry or Support Request</h2>
          <p class="text-sm text-slate-400 mb-6">Fill out the details below and our team will get back to you promptly.</p>

          <form 
            id="infinilink-contact-form"
            name="contact-form" 
            method="POST" 
            data-netlify="true" 
            netlify-honeypot="bot-field" 
            action="/contact?status=success"
            onsubmit="if(window.trackInfinilinkConversion) { window.trackInfinilinkConversion('lead', { formName: 'Contact Inquiry Form' }); }"
            class="space-y-4"
          >
            <input type="hidden" name="form-name" value="contact-form" />
            <p class="hidden"><label>Do not fill: <input name="bot-field" /></label></p>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="contact-name" class="block text-sm font-medium text-slate-300 mb-1">Full Name</label>
                <input 
                  type="text" 
                  id="contact-name" 
                  name="name" 
                  required 
                  placeholder="John Doe" 
                  class="w-full bg-slate-800 border border-slate-700 text-white rounded-lg px-4 py-3 focus:outline-none focus:ring-2 focus:ring-blue-500" 
                />
              </div>
              <div>
                <label for="contact-phone" class="block text-sm font-medium text-slate-300 mb-1">Phone Number</label>
                <input 
                  type="tel" 
                  id="contact-phone" 
                  name="phone" 
                  required 
                  placeholder="(940) 555-0100" 
                  class="w-full bg-slate-800 border border-slate-700 text-white rounded-lg px-4 py-3 focus:outline-none focus:ring-2 focus:ring-blue-500" 
                />
              </div>
            </div>

            <div>
              <label for="contact-email" class="block text-sm font-medium text-slate-300 mb-1">Email Address</label>
              <input 
                type="email" 
                id="contact-email" 
                name="email" 
                required 
                placeholder="john@example.com" 
                class="w-full bg-slate-800 border border-slate-700 text-white rounded-lg px-4 py-3 focus:outline-none focus:ring-2 focus:ring-blue-500" 
              />
            </div>

            <div>
              <label for="contact-subject" class="block text-sm font-medium text-slate-300 mb-1">Subject / Inquiry Type</label>
              <select 
                id="contact-subject" 
                name="subject" 
                class="w-full bg-slate-800 border border-slate-700 text-white rounded-lg px-4 py-3 focus:outline-none focus:ring-2 focus:ring-blue-500"
              >
                <option value="new-service">New Residential Service Inquiry</option>
                <option value="business-service">Commercial / Business Dedicated Broadband</option>
                <option value="support">Existing Customer Technical Support</option>
                <option value="billing">Billing & Account Inquiry</option>
              </select>
            </div>

            <div>
              <label for="contact-message" class="block text-sm font-medium text-slate-300 mb-1">Street Address or Message Details</label>
              <textarea 
                id="contact-message" 
                name="message" 
                rows="4" 
                required 
                placeholder="Please include your Wise County street address if inquiring about new service availability..."
                class="w-full bg-slate-800 border border-slate-700 text-white rounded-lg px-4 py-3 focus:outline-none focus:ring-2 focus:ring-blue-500"
              ></textarea>
            </div>

            <button 
              type="submit" 
              class="w-full bg-gradient-to-r from-blue-600 to-cyan-600 hover:from-blue-500 hover:to-cyan-500 text-white font-bold py-3.5 rounded-lg shadow-lg transition duration-200"
            >
              Submit Message
            </button>
          </form>
        </div>

      </div>

    </div>
  </div>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', function() {
      var urlParams = new URLSearchParams(window.location.search);
      if (urlParams.get('status') === 'success') {
        var banner = document.getElementById('success-banner');
        if (banner) {
          banner.classList.remove('hidden');
          banner.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
        if (window.trackInfinilinkConversion) {
          window.trackInfinilinkConversion('lead', { formName: 'Form Submission Confirmation Page' });
        }
      }
    });
  </script>
</BaseLayout>
