---
import BaseLayout from '../layouts/BaseLayout.astro';
import ServiceAvailabilityForm from '../components/ServiceAvailabilityForm.astro';
import PlanComparisonTable from '../components/PlanComparisonTable.astro';
import FAQAccordion from '../components/FAQAccordion.astro';
import VideoAdShowcase from '../components/VideoAdShowcase.astro';

const localAreas = [
  { name: 'Runaway Bay, TX', href: '/service-areas/internet-provider-runaway-bay-tx', desc: 'Lake Bridgeport waterfront & steady neighborhood streaming' },
  { name: 'Bridgeport, TX', href: '/service-areas/rural-internet-bridgeport-tx', desc: 'Agricultural acreage & work-from-home reliability' },
  { name: 'Decatur, TX', href: '/service-areas/high-speed-internet-decatur-tx', desc: 'Wise County seat coverage & residential ranches' },
  { name: 'Alvord, TX', href: '/service-areas/high-speed-internet-alvord-tx', desc: 'North Wise County unlimited high-speed broadband' },
  { name: 'Paradise, TX', href: '/service-areas/internet-service-paradise-tx', desc: 'South Wise County family-owned wireless connectivity' },
];
---

<BaseLayout 
  title="Your Local Internet Company | Infinilink Broadband Wise County, TX" 
  description="Infinilink Broadband delivers honest, reliable internet across Runaway Bay, Bridgeport, Decatur, and Wise County. Zero contracts, zero data caps, real speeds."
>

  <!-- Hero Section (Light & Clean) -->
  <section class="relative bg-white pt-10 pb-16 lg:pt-16 lg:pb-24 border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        
        <!-- Left Hero Copy -->
        <div class="lg:col-span-7 space-y-6 text-center lg:text-left">
          
          <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-blue-50 border border-blue-200 text-sm font-bold text-navy-900">
            <span class="w-2.5 h-2.5 rounded-full bg-emerald-600 inline-block" aria-hidden="true"></span>
            Wise County's Local Internet Provider
          </div>

          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black text-navy-950 tracking-tight leading-[1.15]">
            Your Local Internet Company.<br/>
            <span class="text-infinite-blue">Real People. Real Speeds.</span><br/>
            No Contracts.
          </h1>

          <p class="text-lg sm:text-xl text-slate-700 max-w-2xl mx-auto lg:mx-0 leading-relaxed font-normal">
            Fast is nice. Steady is better. Built so video calls don't freeze and movies don't buffer, even at 8 pm. Real speeds, not "up to" speeds.
          </p>

          <!-- Key Benefit Badges -->
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 pt-2 max-w-xl mx-auto lg:mx-0 text-left">
            <div class="bg-slate-50 border border-slate-200 p-4 rounded-xl shadow-xs">
              <div class="text-2xl font-black text-infinite-blue">0 GB</div>
              <div class="text-sm text-slate-700 font-bold uppercase tracking-wide">Data Caps Ever</div>
              <p class="text-sm text-slate-600 mt-0.5">No throttling or penalties</p>
            </div>
            <div class="bg-slate-50 border border-slate-200 p-4 rounded-xl shadow-xs">
              <div class="text-2xl font-black text-emerald-700">20–35ms</div>
              <div class="text-sm text-slate-700 font-bold uppercase tracking-wide">Typical Low Lag</div>
              <p class="text-sm text-slate-600 mt-0.5">Smooth calls & video</p>
            </div>
            <div class="bg-slate-50 border border-slate-200 p-4 rounded-xl shadow-xs">
              <div class="text-2xl font-black text-navy-900">100%</div>
              <div class="text-sm text-slate-700 font-bold uppercase tracking-wide">Local Family Team</div>
              <p class="text-sm text-slate-600 mt-0.5">Runaway Bay, TX</p>
            </div>
          </div>

          <!-- Hero Action Buttons -->
          <div class="pt-4 flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4">
            <a 
              href="#service-check" 
              class="w-full sm:w-auto bg-infinite-blue hover:bg-infinite-blue-dark text-white font-bold py-4 px-8 rounded-xl shadow-xs transition duration-200 text-center min-h-[48px] flex items-center justify-center text-lg"
              data-track="hero-check-availability"
            >
              Check Your Address
            </a>
            <a 
              href="tel:+19404370550" 
              class="w-full sm:w-auto bg-white hover:bg-slate-50 text-navy-950 border-2 border-navy-900 font-bold py-4 px-6 rounded-xl flex items-center justify-center gap-2 shadow-xs transition duration-200 min-h-[48px] text-lg"
              data-track="hero-call"
            >
              <svg class="w-5 h-5 text-infinite-blue" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
              </svg>
              <span>Call (940) 437-0550</span>
            </a>
          </div>

          <p class="text-sm text-slate-600 pt-1">
            Free line-of-sight check before you pay a dime. If we can't give you a good connection, we'll tell you upfront.
          </p>

        </div>

        <!-- Right Hero Form -->
        <div class="lg:col-span-5" id="service-check">
          <ServiceAvailabilityForm />
        </div>

      </div>
    </div>
  </section>

  <!-- Navy Trust & Reliability Bar -->
  <section class="bg-navy-900 text-white py-8 border-b border-navy-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 text-center md:text-left items-center">
        <div class="flex items-center justify-center md:justify-start gap-3">
          <div class="w-10 h-10 rounded-full bg-navy-800 border border-navy-700 flex items-center justify-center text-emerald-400 shrink-0">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
          </div>
          <div>
            <div class="font-bold text-white text-base">Triple Fiber Backhaul</div>
            <div class="text-slate-300 text-sm">Three separate fiber lines feed our network</div>
          </div>
        </div>

        <div class="flex items-center justify-center md:justify-start gap-3">
          <div class="w-10 h-10 rounded-full bg-navy-800 border border-navy-700 flex items-center justify-center text-emerald-400 shrink-0">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <div>
            <div class="font-bold text-white text-base">100% Uptime (Last 90 Days)</div>
            <div class="text-slate-300 text-sm">
              <a href="https://status.infinilinkbroadband.com" target="_blank" rel="noopener noreferrer" class="text-sky-300 hover:text-white underline">
                View live public status &rarr;
              </a>
            </div>
          </div>
        </div>

        <div class="flex items-center justify-center md:justify-start gap-3">
          <div class="w-10 h-10 rounded-full bg-navy-800 border border-navy-700 flex items-center justify-center text-emerald-400 shrink-0">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z" />
            </svg>
          </div>
          <div>
            <div class="font-bold text-white text-base">Local Support by Phone or Text</div>
            <div class="text-slate-300 text-sm">Most problems solved within the hour</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Value Pillars Section -->
  <section class="py-16 sm:py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-3xl mx-auto mb-12">
        <h2 class="text-3xl sm:text-4xl font-black text-navy-950 tracking-tight">
          Internet the Way It Should Be in Wise County
        </h2>
        <p class="mt-3 text-lg text-slate-700 font-medium">
          No dish to buy. No satellite lag. When something is wrong, you call a neighbor, not a chatbot.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        
        <div class="bg-slate-50 border border-slate-200 p-8 rounded-2xl space-y-4 hover:border-infinite-blue transition shadow-xs">
          <div class="w-12 h-12 rounded-xl bg-blue-100 text-infinite-blue flex items-center justify-center">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
            </svg>
          </div>
          <h3 class="text-xl font-bold text-navy-950">Smooth Streaming & Video Calls</h3>
          <p class="text-slate-700 text-base leading-relaxed">
            Video call the grandkids without the picture freezing. Land-based towers provide steady connections without satellite lag, so your movies won't buffer at 8 pm.
          </p>
        </div>

        <div class="bg-slate-50 border border-slate-200 p-8 rounded-2xl space-y-4 hover:border-infinite-blue transition shadow-xs">
          <div class="w-12 h-12 rounded-xl bg-blue-100 text-infinite-blue flex items-center justify-center">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
            </svg>
          </div>
          <h3 class="text-xl font-bold text-navy-950">Zero Data Caps & No Throttling</h3>
          <p class="text-slate-700 text-base leading-relaxed">
            One flat price every month. Download updates, stream TV shows, and connect every device in your home. You will never receive an overage bill or speed penalty.
          </p>
        </div>

        <div class="bg-slate-50 border border-slate-200 p-8 rounded-2xl space-y-4 hover:border-infinite-blue transition shadow-xs">
          <div class="w-12 h-12 rounded-xl bg-blue-100 text-infinite-blue flex items-center justify-center">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
            </svg>
          </div>
          <h3 class="text-xl font-bold text-navy-950">We Handle the Whole Setup</h3>
          <p class="text-slate-700 text-base leading-relaxed">
            We do it all: the antenna, the router, and your Wi-Fi. No tech talk required. Most problems are solved within the hour by phone or text.
          </p>
        </div>

      </div>
    </div>
  </section>

  <!-- Video Showcase Component -->
  <VideoAdShowcase />

  <!-- Transparent Plans Section -->
  <section class="py-16 sm:py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-3xl mx-auto mb-12">
        <span class="text-sm font-bold text-infinite-blue uppercase tracking-widest">Straightforward Plans</span>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black text-navy-950 tracking-tight mt-2">
          Choose the Right Plan for Your Home
        </h2>
        <p class="mt-4 text-base sm:text-lg text-slate-700 font-medium">
          One flat price. No contracts. No data caps. No throttling. Same plans and prices for homes and businesses.
        </p>
      </div>

      <PlanComparisonTable highlightedPlan="plus" />

    </div>
  </section>

  <!-- Security & Customer Care Callout Band (Navy) -->
  <section class="py-12 bg-navy-900 text-white border-y border-navy-800">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-navy-950 border border-navy-800 rounded-2xl p-6 sm:p-8 flex flex-col md:flex-row items-center gap-6">
        <div class="w-14 h-14 rounded-full bg-navy-900 border border-navy-700 flex items-center justify-center text-amber-400 shrink-0">
          <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
          </svg>
        </div>
        <div class="space-y-2 text-center md:text-left">
          <h3 class="text-xl font-bold text-white">Our Security Promise to Neighbors</h3>
          <p class="text-slate-100 text-base leading-relaxed">
            Same price every month. Pay by check, by phone, or online through our secure portal. <strong class="text-white">We will never call asking for your password or for payment by gift card.</strong> If you're ever unsure about a call or message, hang up and call our Runaway Bay office directly at <a href="tel:+19404370550" class="text-sky-300 font-bold hover:underline">(940) 437-0550</a>.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Wise County Coverage Areas Hub Grid -->
  <section class="py-16 bg-slate-50 border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-3xl mx-auto mb-12">
        <h2 class="text-3xl font-black text-navy-950 tracking-tight sm:text-4xl">
          Serving Communities Across Wise County, TX
        </h2>
        <p class="mt-3 text-slate-700 font-medium text-base sm:text-lg">
          Click your nearest town to view local tower coverage and setup details:
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {localAreas.map((area) => (
          <a 
            href={area.href} 
            class="bg-white border border-slate-200 hover:border-infinite-blue p-6 rounded-xl transition duration-200 group flex flex-col justify-between shadow-xs hover:shadow-md min-h-[44px]"
          >
            <div>
              <div class="flex items-center justify-between mb-2">
                <h3 class="text-xl font-bold text-navy-950 group-hover:text-infinite-blue transition">{area.name}</h3>
                <span class="text-emerald-900 text-xs font-bold bg-emerald-50 px-2.5 py-1 rounded border border-emerald-200">Active Towers</span>
              </div>
              <p class="text-sm text-slate-700 leading-relaxed mb-4">{area.desc}</p>
            </div>
            <div class="text-sm font-bold text-infinite-blue flex items-center gap-1 group-hover:translate-x-1 transition-transform">
              <span>View local area details</span>
              <svg class="w-4 h-4 text-infinite-blue" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
              </svg>
            </div>
          </a>
        ))}

        <div class="bg-blue-50 border border-blue-200 p-6 rounded-xl flex flex-col justify-between shadow-xs">
          <div>
            <h3 class="text-xl font-bold text-navy-950 mb-2">Barns, Shops & Outlying Land</h3>
            <p class="text-sm text-slate-700 leading-relaxed mb-4">
              Have an acreage property, barn, or barndominium outside town? Ask us about custom multi-building wireless links.
            </p>
          </div>
          <a href="#service-check" class="text-sm font-bold text-infinite-blue hover:text-infinite-blue-dark flex items-center gap-1">
            <span>Request custom property quote &rarr;</span>
          </a>
        </div>
      </div>

    </div>
  </section>

  <!-- FAQ Section with Schema -->
  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <FAQAccordion />
    </div>
  </section>

  <!-- Final Call to Action (Navy Band) -->
  <section class="py-16 sm:py-20 bg-navy-950 text-white border-t border-navy-900">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-6">
      <h2 class="text-3xl sm:text-4xl font-black text-white tracking-tight">
        Ready for Honest Internet in Wise County?
      </h2>
      <p class="text-base sm:text-lg text-slate-100 max-w-2xl mx-auto leading-relaxed font-medium">
        Speak with a real person at our Runaway Bay office today to verify line-of-sight and schedule your free check.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-4">
        <a 
          href="#service-check" 
          class="w-full sm:w-auto bg-infinite-blue hover:bg-infinite-blue-dark text-white font-bold py-4 px-8 rounded-xl shadow-xs transition duration-200 text-lg min-h-[48px] flex items-center justify-center"
          data-track="final-cta-check"
        >
          Check Address Availability
        </a>
        <a 
          href="tel:+19404370550" 
          class="w-full sm:w-auto bg-white hover:bg-slate-100 text-navy-950 font-bold py-4 px-8 rounded-xl flex items-center justify-center gap-2 shadow-xs transition duration-200 text-lg min-h-[48px]"
          data-track="final-cta-call"
        >
          <span>Call: (940) 437-0550</span>
        </a>
      </div>
    </div>
  </section>

</BaseLayout>
