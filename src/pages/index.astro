---
import BaseLayout from '../layouts/BaseLayout.astro';
import ServiceAvailabilityForm from '../components/ServiceAvailabilityForm.astro';
import PlanComparisonTable from '../components/PlanComparisonTable.astro';
import FAQAccordion from '../components/FAQAccordion.astro';
import VideoAdShowcase from '../components/VideoAdShowcase.astro';

const localAreas = [
  { name: 'Decatur, TX', href: '/service-areas/high-speed-internet-decatur-tx', desc: 'Wise County seat tower reach & residential ranches' },
  { name: 'Runaway Bay, TX', href: '/service-areas/internet-provider-runaway-bay-tx', desc: 'Lake Bridgeport waterfront & low-latency streaming' },
  { name: 'Bridgeport, TX', href: '/service-areas/rural-internet-bridgeport-tx', desc: 'Agricultural acreage & work-from-home reliability' },
  { name: 'Alvord, TX', href: '/service-areas/high-speed-internet-alvord-tx', desc: 'North Wise County unlimited high-speed broadband' },
  { name: 'Paradise, TX', href: '/service-areas/internet-service-paradise-tx', desc: 'South Wise County family-owned wireless connectivity' },
];
---

<BaseLayout 
  title="Fast, Truly Unlimited Rural Internet in Wise County, TX" 
  description="Infinilink Broadband delivers high-speed fixed wireless internet with zero data caps, low ping, and same-day local support across Decatur, Runaway Bay, Bridgeport, and Wise County."
>

  <!-- Hero Section with Background Glow and Lead Capture -->
  <section class="relative overflow-hidden pt-12 pb-20 lg:pt-20 lg:pb-28">
    <div class="absolute inset-0 bg-radial from-blue-900/20 via-slate-950 to-slate-950 pointer-events-none"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        
        <!-- Left Hero Copy -->
        <div class="lg:col-span-7 space-y-6 text-center lg:text-left">
          
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-slate-900 border border-slate-800 text-xs font-semibold text-cyan-400">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
            Wise County's Premier Local WISP
          </div>

          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black text-white tracking-tight leading-[1.1]">
            Truly Unlimited <br/>
            <span class="bg-clip-text text-transparent bg-gradient-to-r from-blue-400 via-cyan-400 to-sky-300">
              High-Speed Internet
            </span> <br/>
            Across Wise County.
          </h1>

          <p class="text-lg sm:text-xl text-slate-300 max-w-2xl mx-auto lg:mx-0 leading-relaxed">
            Tired of satellite lag, low data limits, and empty promises from national telecoms? Infinilink delivers ultra-fast fixed wireless broadband with <strong class="text-white">zero data caps, low ping,</strong> and <strong class="text-white">local same-day tech dispatch</strong>.
          </p>

          <!-- Key Benefit Badges -->
          <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 pt-2 max-w-xl mx-auto lg:mx-0">
            <div class="bg-slate-900/80 border border-slate-800 p-3 rounded-xl text-center">
              <div class="text-xl font-black text-cyan-400">0 GB</div>
              <div class="text-[11px] text-slate-400 uppercase font-semibold">Data Caps Ever</div>
            </div>
            <div class="bg-slate-900/80 border border-slate-800 p-3 rounded-xl text-center">
              <div class="text-xl font-black text-emerald-400">&lt;30ms</div>
              <div class="text-[11px] text-slate-400 uppercase font-semibold">Low Latency Ping</div>
            </div>
            <div class="bg-slate-900/80 border border-slate-800 p-3 rounded-xl text-center col-span-2 sm:col-span-1">
              <div class="text-xl font-black text-blue-400">100%</div>
              <div class="text-[11px] text-slate-400 uppercase font-semibold">Local Decatur Team</div>
            </div>
          </div>

          <div class="pt-4 flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4">
            <a 
              href="#service-check" 
              class="w-full sm:w-auto bg-gradient-to-r from-blue-600 to-cyan-600 hover:from-blue-500 hover:to-cyan-500 text-white font-bold py-4 px-8 rounded-xl shadow-xl shadow-cyan-500/20 transition duration-200 text-center"
            >
              Check Your Address
            </a>
            <a 
              href="tel:9404370550" 
              class="w-full sm:w-auto bg-slate-900 hover:bg-slate-800 text-slate-200 border border-slate-800 font-bold py-4 px-6 rounded-xl flex items-center justify-center gap-2 transition"
            >
              <svg class="w-5 h-5 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
              </svg>
              <span>(940) 437-0550</span>
            </a>
          </div>

        </div>

        <!-- Right Hero Form -->
        <div class="lg:col-span-5" id="service-check">
          <ServiceAvailabilityForm />
        </div>

      </div>
    </div>
  </section>

  <!-- Value Pillars Section -->
  <section class="py-16 bg-slate-900/50 border-y border-slate-800/80">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-3xl mx-auto mb-12">
        <h2 class="text-3xl sm:text-4xl font-black text-white tracking-tight">
          Engineered for Real Rural Performance
        </h2>
        <p class="mt-3 text-slate-400">
          We don't route your data to space or rely on 50-year-old copper phone lines. Here is why Wise County trusts Infinilink:
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        
        <div class="bg-slate-900 border border-slate-800 p-8 rounded-2xl space-y-4 hover:border-cyan-500/40 transition">
          <div class="w-12 h-12 rounded-xl bg-blue-950 text-cyan-400 border border-blue-800 flex items-center justify-center">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
            </svg>
          </div>
          <h3 class="text-xl font-bold text-white">Low Latency Gaming & 4K</h3>
          <p class="text-slate-400 text-sm leading-relaxed">
            Terrestrial microwave towers mean round-trip ping times under 30ms. Play fast multiplayer games, join Zoom meetings with zero stutter, and stream 4K movies smoothly.
          </p>
        </div>

        <div class="bg-slate-900 border border-slate-800 p-8 rounded-2xl space-y-4 hover:border-cyan-500/40 transition">
          <div class="w-12 h-12 rounded-xl bg-cyan-950 text-cyan-400 border border-cyan-800 flex items-center justify-center">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
            </svg>
          </div>
          <h3 class="text-xl font-bold text-white">Zero Data Caps & No Throttling</h3>
          <p class="text-slate-400 text-sm leading-relaxed">
            Download game patches, backup photos to the cloud, and connect every smart device in your home. You will never receive an overage bill or speed penalty.
          </p>
        </div>

        <div class="bg-slate-900 border border-slate-800 p-8 rounded-2xl space-y-4 hover:border-cyan-500/40 transition">
          <div class="w-12 h-12 rounded-xl bg-emerald-950 text-emerald-400 border border-emerald-800 flex items-center justify-center">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
            </svg>
          </div>
          <h3 class="text-xl font-bold text-white">Same-Day Local Dispatch</h3>
          <p class="text-slate-400 text-sm leading-relaxed">
            Our certified field technicians are headquartered in Decatur. If you ever need an antenna adjustment or setup help, we are minutes away, not days.
          </p>
        </div>

      </div>
    </div>
  </section>

  <!-- High-Converting Video Ad & Commercial Showcase -->
  <VideoAdShowcase />

  <!-- Transparent Plans Section -->
  <section class="py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-3xl mx-auto mb-16">
        <span class="text-xs font-bold text-cyan-400 uppercase tracking-widest">Straightforward Pricing</span>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black text-white tracking-tight mt-2">
          Choose the Perfect Internet Plan
        </h2>
        <p class="mt-4 text-base sm:text-lg text-slate-300">
          No mandatory contracts. No equipment rental surprises. Just reliable, unlimited high-speed broadband.
        </p>
      </div>

      <PlanComparisonTable highlightedPlan="plus" />

    </div>
  </section>

  <!-- Wise County Coverage Areas Hub Grid -->
  <section class="py-16 bg-slate-900/40 border-t border-slate-800/80">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-3xl mx-auto mb-12">
        <h2 class="text-3xl font-black text-white tracking-tight sm:text-4xl">
          Serving Communities Across Wise County, TX
        </h2>
        <p class="mt-3 text-slate-400">
          Click your nearest community to review dedicated tower coverage and localized install timelines:
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {localAreas.map((area) => (
          <a 
            href={area.href} 
            class="bg-slate-900 border border-slate-800 hover:border-cyan-500 p-6 rounded-xl transition duration-200 group flex flex-col justify-between"
          >
            <div>
              <div class="flex items-center justify-between mb-2">
                <h3 class="text-lg font-bold text-white group-hover:text-cyan-400 transition">{area.name}</h3>
                <span class="text-emerald-400 text-xs font-semibold bg-emerald-950 px-2 py-0.5 rounded border border-emerald-800">Active</span>
              </div>
              <p class="text-xs text-slate-400 leading-relaxed mb-4">{area.desc}</p>
            </div>
            <div class="text-xs font-semibold text-cyan-400 flex items-center gap-1 group-hover:translate-x-1 transition-transform">
              <span>View local coverage details</span>
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
              </svg>
            </div>
          </a>
        ))}

        <div class="bg-gradient-to-br from-blue-950/60 to-slate-900 border border-blue-800/60 p-6 rounded-xl flex flex-col justify-between">
          <div>
            <h3 class="text-lg font-bold text-white mb-2">Rural Ranches & Outlying Land</h3>
            <p class="text-xs text-slate-300 leading-relaxed mb-4">
              Have an acreage property or barndominium outside city limits? Our high-gain receivers can connect properties up to 10+ miles from our towers.
            </p>
          </div>
          <a href="#service-check" class="text-xs font-bold text-cyan-300 hover:text-white flex items-center gap-1">
            <span>Check custom ranch availability →</span>
          </a>
        </div>
      </div>

    </div>
  </section>

  <!-- FAQ Section with Schema -->
  <section class="py-16 bg-slate-950">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <FAQAccordion />
    </div>
  </section>

  <!-- Final Call to Action -->
  <section class="py-20 bg-gradient-to-b from-slate-900 to-slate-950 border-t border-slate-800">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-6">
      <h2 class="text-3xl sm:text-4xl font-black text-white tracking-tight">
        Ready for Internet that Actually Works in Wise County?
      </h2>
      <p class="text-base sm:text-lg text-slate-300 max-w-2xl mx-auto leading-relaxed">
        Speak with our local Decatur team today to verify line-of-sight and schedule your professional installation.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-4">
        <a 
          href="#service-check" 
          class="w-full sm:w-auto bg-gradient-to-r from-blue-600 to-cyan-600 hover:from-blue-500 hover:to-cyan-500 text-white font-bold py-4 px-8 rounded-xl shadow-xl transition"
        >
          Check Address Availability
        </a>
        <a 
          href="tel:9404370550" 
          class="w-full sm:w-auto bg-slate-800 hover:bg-slate-700 text-white border border-slate-700 font-bold py-4 px-6 rounded-xl flex items-center justify-center gap-2 transition"
        >
          <span>Call Local Support: (940) 437-0550</span>
        </a>
      </div>
    </div>
  </section>

</BaseLayout>
