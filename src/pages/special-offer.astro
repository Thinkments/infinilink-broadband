---
import BaseLayout from '../layouts/BaseLayout.astro';
import ServiceAvailabilityForm from '../components/ServiceAvailabilityForm.astro';
import PlanComparisonTable from '../components/PlanComparisonTable.astro';
import VideoAdShowcase from '../components/VideoAdShowcase.astro';

// Dedicated PPC / Ad Conversion Route
---

<BaseLayout 
  title="Special Internet Offer for Wise County Residents | Infinilink Broadband" 
  description="Local internet in Wise County, TX. Fast fixed wireless, zero data caps, steady speeds, and local family support from $40/mo."
>
  <!-- Hero Section with Focused Ad Headline & Instant Address Check -->
  <section class="relative bg-white pt-12 pb-16 lg:pt-16 lg:pb-24 border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-3xl mx-auto mb-8">
        <span class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-blue-50 text-navy-900 border border-blue-200 text-sm font-bold uppercase tracking-wider mb-4">
          <span class="w-2.5 h-2.5 rounded-full bg-emerald-600 inline-block" aria-hidden="true"></span>
          Wise County Local Internet
        </span>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black text-navy-950 tracking-tight leading-[1.15]">
          Your Local Internet Company.<br />
          <span class="text-infinite-blue">Real Speeds. No Contracts.</span>
        </h1>
        <p class="mt-4 text-lg sm:text-xl text-slate-700 font-normal">
          Fast is nice. Steady is better. Built so video calls don't freeze and movies don't buffer, even at 8 pm. Real speeds, not "up to" speeds.
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center mt-8">
        
        <!-- Left: Quick Highlights & Trust Badges -->
        <div class="lg:col-span-6 space-y-6">
          <div class="bg-slate-50 border border-slate-200 p-6 sm:p-8 rounded-2xl shadow-xs space-y-6">
            <h2 class="text-2xl font-black text-navy-950">
              Why Wise County Neighbors Choose Infinilink:
            </h2>

            <ul class="space-y-4">
              <li class="flex items-start gap-3.5">
                <div class="w-6 h-6 rounded-full bg-blue-100 text-infinite-blue flex items-center justify-center flex-shrink-0 mt-0.5">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path>
                  </svg>
                </div>
                <div>
                  <strong class="text-navy-950 font-bold text-base">Zero Data Caps & Zero Throttling:</strong>
                  <p class="text-base text-slate-700">Stream TV, join video calls, and connect every device without limits.</p>
                </div>
              </li>

              <li class="flex items-start gap-3.5">
                <div class="w-6 h-6 rounded-full bg-blue-100 text-infinite-blue flex items-center justify-center flex-shrink-0 mt-0.5">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path>
                  </svg>
                </div>
                <div>
                  <strong class="text-navy-950 font-bold text-base">One Flat Price Every Month ($40–$110/mo):</strong>
                  <p class="text-base text-slate-700">No surprise equipment rental fees or price hikes. Pay by check, phone, or online.</p>
                </div>
              </li>

              <li class="flex items-start gap-3.5">
                <div class="w-6 h-6 rounded-full bg-blue-100 text-infinite-blue flex items-center justify-center flex-shrink-0 mt-0.5">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path>
                  </svg>
                </div>
                <div>
                  <strong class="text-navy-950 font-bold text-base">Local Support by Phone or Text:</strong>
                  <p class="text-base text-slate-700">Call a neighbor, not a chatbot. Most problems solved within the hour.</p>
                </div>
              </li>
            </ul>

            <div class="pt-4 border-t border-slate-200 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
              <div>
                <p class="text-sm text-slate-600 font-medium">Prefer to speak with someone?</p>
                <a 
                  href="tel:+19404370550" 
                  class="text-xl font-black text-infinite-blue hover:text-infinite-blue-dark" 
                  aria-label="Call (940) 437-0550"
                  data-track="special-offer-call"
                >
                  (940) 437-0550
                </a>
              </div>
              <span class="px-3.5 py-1.5 rounded-full bg-blue-50 text-navy-900 text-sm font-bold border border-blue-200 text-center">
                Free Line-of-Sight Check
              </span>
            </div>
          </div>
        </div>

        <!-- Right: Primary Lead Capture Form -->
        <div class="lg:col-span-6" id="service-check">
          <ServiceAvailabilityForm 
            title="Check Coverage for Your Property" 
            subtitle="Enter your Wise County address to verify free line-of-sight signal strength."
          />
        </div>

      </div>

    </div>
  </section>

  <!-- Video Showcase Feature -->
  <VideoAdShowcase 
    title="Learn How We Deliver Reliable Internet"
    subtitle="Watch how local fixed wireless beats satellite lag, hidden fees, and corporate phone trees."
  />

  <!-- Plan Breakdown -->
  <section class="py-16 sm:py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <h2 class="text-3xl sm:text-4xl font-black text-navy-950 tracking-tight">
          Simple, Transparent Pricing Tiers
        </h2>
        <p class="mt-2 text-lg text-slate-700 font-normal">
          One flat price. No contracts. No data caps. No throttling. Same plans and prices for homes and businesses.
        </p>
      </div>
      <PlanComparisonTable highlightedPlan="plus" />
    </div>
  </section>
</BaseLayout>
