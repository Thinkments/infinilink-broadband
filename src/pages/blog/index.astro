---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const categories = ['All Guides', 'Rural Internet Guides', 'Tech & Speeds', 'Community & Wise County', 'Troubleshooting & Wi-Fi'];
---

<BaseLayout 
  title="Rural Internet Guides, Wi-Fi Tech & Wise County Updates" 
  description="Explore technical broadband guides, fixed wireless performance tutorials, and local Wise County connectivity news from Infinilink's engineering team."
>
  <div class="py-16 sm:py-24 bg-slate-950">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Header -->
      <div class="text-center max-w-3xl mx-auto mb-16">
        <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-cyan-950 text-cyan-400 border border-cyan-800 uppercase tracking-wider mb-4">
          Infinilink Tech Journal & E-E-A-T Repository
        </span>
        <h1 class="text-4xl sm:text-5xl font-black text-white tracking-tight mb-4">
          Wise County Broadband Guides & Insights
        </h1>
        <p class="text-lg text-slate-300">
          Practical advice from local RF engineers and network technicians on optimizing rural Wi-Fi, comparing broadband tech, and staying connected in North Texas.
        </p>
      </div>

      <!-- Category Filter Pills -->
      <div class="flex flex-wrap justify-center gap-2 mb-12">
        {categories.map((cat, idx) => (
          <span class={`text-xs font-semibold px-4 py-2 rounded-full cursor-default ${
            idx === 0 
              ? 'bg-gradient-to-r from-blue-600 to-cyan-600 text-white shadow-md' 
              : 'bg-slate-900 text-slate-400 border border-slate-800'
          }`}>
            {cat}
          </span>
        ))}
      </div>

      <!-- Posts Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {posts.map((post) => {
          const heroSrc = typeof post.data.heroImage === 'string' 
            ? post.data.heroImage 
            : (post.data.heroImage?.src || '/assets/hero.jpg');

          const postSlug = post.id;

          return (
            <article class="bg-slate-900/80 rounded-2xl overflow-hidden border border-slate-800 hover:border-cyan-500/50 transition duration-300 flex flex-col group shadow-xl">
              <a href={`/blog/${postSlug}`} class="block relative aspect-video overflow-hidden bg-slate-950">
                <img 
                  src={heroSrc} 
                  alt={post.data.altText || post.data.title}
                  class="w-full h-full object-cover group-hover:scale-105 transition duration-500" 
                  loading="lazy"
                />
                <div class="absolute top-3 left-3 bg-slate-950/80 backdrop-blur-md border border-slate-800 text-cyan-400 text-[11px] font-bold px-2.5 py-1 rounded-md uppercase">
                  {post.data.category}
                </div>
              </a>

              <div class="p-6 flex-1 flex flex-col justify-between">
                <div>
                  <div class="text-xs text-slate-400 mb-2">
                    {post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })} • {post.data.author}
                  </div>
                  <h2 class="text-xl font-bold text-white group-hover:text-cyan-400 transition mb-3 leading-snug">
                    <a href={`/blog/${postSlug}`}>
                      {post.data.title}
                    </a>
                  </h2>
                  <p class="text-slate-400 text-sm leading-relaxed mb-4 line-clamp-3">
                    {post.data.description}
                  </p>
                </div>

                <div class="pt-4 border-t border-slate-800 flex items-center justify-between">
                  <a 
                    href={`/blog/${postSlug}`} 
                    class="text-xs font-bold text-cyan-400 hover:text-cyan-300 flex items-center gap-1 group/btn"
                  >
                    <span>Read Full Guide</span>
                    <svg class="w-3.5 h-3.5 group-hover/btn:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                    </svg>
                  </a>
                </div>
              </div>
            </article>
          );
        })}
      </div>

    </div>
  </div>
</BaseLayout>
