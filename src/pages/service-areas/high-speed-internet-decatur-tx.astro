---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ServiceAvailabilityForm from '../../components/ServiceAvailabilityForm.astro';
import PlanComparisonTable from '../../components/PlanComparisonTable.astro';
import FAQAccordion from '../../components/FAQAccordion.astro';

const decaturFaqs = [
  {
    question: "Where are Infinilink's towers located in Decatur, TX?",
    answer: "Our primary broadcast arrays and microwave relay hubs are positioned on key high-elevation structures surrounding Decatur, providing comprehensive line-of-sight coverage across city subdivisions, CR corridors, and outlying rural ranch acreage."
  },
  {
    question: "How fast can I get internet installed in Decatur?",
    answer: "Because our technician headquarters and dispatch fleet are located directly in Decatur (76234), we routinely offer same-day or next-day site surveys and installations."
  },
  {
    question: "How does Infinilink compare to satellite options in Decatur?",
    answer: "Infinilink fixed wireless offers ping times under 30ms (compared to 600ms+ on traditional satellite), zero data caps, unaffected performance during cloudy weather, and local phone support with zero automated phone trees."
  }
];
---

<BaseLayout 
  title="High Speed Internet Decatur TX | Local Unlimited Provider" 
  description="Looking for the best high speed internet in Decatur, TX? Infinilink delivers truly unlimited fixed wireless broadband, low ping gaming, and same-day Decatur tech dispatch."
>
  <div class="py-16 sm:py-24 bg-slate-950">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Hub Header -->
      <div class="text-center max-w-3xl mx-auto mb-16">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-cyan-950 text-cyan-400 border border-cyan-800 text-xs font-semibold uppercase tracking-wider mb-4">
          <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
          Decatur, Texas • Wise County Seat Hub
        </div>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black text-white tracking-tight mb-6 leading-tight">
          High-Speed Internet in <br />
          <span class="bg-clip-text text-transparent bg-gradient-to-r from-blue-400 to-cyan-400">
            Decatur, Texas (76234)
          </span>
        </h1>
        <p class="text-lg text-slate-300 leading-relaxed">
          Experience truly unlimited, low-latency fixed wireless broadband engineered specifically for Decatur homes, ranches, and small businesses. No satellite lag, zero data caps, and local community roots.
        </p>
      </div>

      <!-- Local Service Highlights -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-20">
        
        <div class="bg-slate-900 border border-slate-800 p-8 rounded-2xl space-y-4">
          <div class="w-12 h-12 rounded-xl bg-blue-950 text-cyan-400 flex items-center justify-center font-bold text-xl">
            📡
          </div>
          <h2 class="text-xl font-bold text-white">Direct Decatur Tower Line-of-Sight</h2>
          <p class="text-sm text-slate-400 leading-relaxed">
            Our multi-gigabit microwave relays broadcast across Decatur's rolling terrain, delivering fiber-grade throughput to properties that cable and fiber telecoms have bypassed.
          </p>
        </div>

        <div class="bg-slate-900 border border-slate-800 p-8 rounded-2xl space-y-4">
          <div class="w-12 h-12 rounded-xl bg-cyan-950 text-cyan-400 flex items-center justify-center font-bold text-xl">
            ⚡
          </div>
          <h2 class="text-xl font-bold text-white">Sub-30ms Gaming & 4K Streaming</h2>
          <p class="text-sm text-slate-400 leading-relaxed">
            Say goodbye to buffering circles and high ping. Our ground-level transmission enables seamless multiplayer gaming, crystal-clear Zoom video calls, and multi-screen 4K television.
          </p>
        </div>

        <div class="bg-slate-900 border border-slate-800 p-8 rounded-2xl space-y-4">
          <div class="w-12 h-12 rounded-xl bg-emerald-950 text-emerald-400 flex items-center justify-center font-bold text-xl">
            🛠️
          </div>
          <h2 class="text-xl font-bold text-white">Same-Day Local Tech Dispatch</h2>
          <p class="text-sm text-slate-400 leading-relaxed">
            When you call `(940) 437-0550`, you are speaking with technicians right here in Decatur. We provide prompt on-site alignments and same-day service checks.
          </p>
        </div>

      </div>

      <!-- Plan Pricing Matrix -->
      <div class="mb-20">
        <div class="text-center max-w-2xl mx-auto mb-12">
          <h2 class="text-3xl font-black text-white">Unlimited Internet Plans for Decatur Residents</h2>
          <p class="text-slate-400 text-sm mt-2">All plans include zero contracts, no data overage charges, and local customer support.</p>
        </div>
        <PlanComparisonTable highlightedPlan="plus" />
      </div>

      <!-- Lead Capture -->
      <div class="max-w-3xl mx-auto mb-20" id="service-check">
        <ServiceAvailabilityForm 
          title="Check Service Availability in Decatur, TX"
          subtitle="Enter your street address to verify immediate signal strength from our Decatur towers."
        />
      </div>

      <!-- Local FAQ -->
      <FAQAccordion 
        faqs={decaturFaqs} 
        title="Decatur Internet Service FAQs" 
        subtitle="Answers to common questions from Decatur and Wise County homeowners."
      />

    </div>
  </div>
</BaseLayout>
