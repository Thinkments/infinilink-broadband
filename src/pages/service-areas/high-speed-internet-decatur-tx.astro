---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ServiceAvailabilityForm from '../../components/ServiceAvailabilityForm.astro';
import PlanComparisonTable from '../../components/PlanComparisonTable.astro';
import FAQAccordion from '../../components/FAQAccordion.astro';

const decaturFaqs = [
  {
    question: "Where are Infinilink's towers located around Decatur, TX?",
    answer: "Our broadcast antennas are positioned on high-elevation structures surrounding Decatur, providing steady line-of-sight coverage across town neighborhoods, ranch acreage, and rural roads."
  },
  {
    question: "How fast can I get internet installed in Decatur?",
    answer: "Every installation starts with a free line-of-sight check. Because our family team is right here in Wise County, we can often check your property within 24 to 48 hours and get your installation scheduled promptly."
  },
  {
    question: "How does Infinilink compare to satellite options in Decatur?",
    answer: "Infinilink fixed wireless offers low lag (typically 20–35ms ping compared to hundreds of milliseconds on satellite), zero data caps, steady performance in rain, and direct phone support from real people."
  }
];
---

<BaseLayout 
  title="High Speed Internet Decatur TX | Local Unlimited Provider" 
  description="Looking for reliable high speed internet in Decatur, TX? Infinilink delivers truly unlimited fixed wireless broadband, steady speeds, and local Wise County support."
>
  <div class="py-16 sm:py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Hub Header -->
      <div class="text-center max-w-3xl mx-auto mb-16">
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-blue-50 text-navy-900 border border-blue-200 text-sm font-semibold uppercase tracking-wider mb-4">
          <span class="w-2.5 h-2.5 rounded-full bg-emerald-600 inline-block"></span>
          Decatur, Texas • Wise County
        </div>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black text-navy-950 tracking-tight mb-6 leading-tight">
          High-Speed Internet in <br />
          <span class="text-infinite-blue">
            Decatur, Texas (76234)
          </span>
        </h1>
        <p class="text-lg sm:text-xl text-slate-700 leading-relaxed font-normal">
          Experience truly unlimited fixed wireless broadband engineered for Decatur homes, ranches, and small businesses. No satellite lag, zero data caps, and local community roots.
        </p>
      </div>

      <!-- Local Service Highlights -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-20">
        
        <div class="bg-slate-50 border border-slate-200 p-8 rounded-2xl shadow-xs space-y-4">
          <div class="w-12 h-12 rounded-xl bg-blue-100 text-infinite-blue flex items-center justify-center font-bold text-xl" aria-hidden="true">
            📡
          </div>
          <h2 class="text-xl font-bold text-navy-950">Direct Decatur Tower Coverage</h2>
          <p class="text-base text-slate-700 leading-relaxed font-normal">
            Our wireless towers broadcast across Decatur's terrain, delivering steady internet to acreage properties and homes where cable telecoms won't build.
          </p>
        </div>

        <div class="bg-slate-50 border border-slate-200 p-8 rounded-2xl shadow-xs space-y-4">
          <div class="w-12 h-12 rounded-xl bg-blue-100 text-infinite-blue flex items-center justify-center font-bold text-xl" aria-hidden="true">
            ⚡
          </div>
          <h2 class="text-xl font-bold text-navy-950">Steady Speeds & Low Lag</h2>
          <p class="text-base text-slate-700 leading-relaxed font-normal">
            Fast is nice, steady is better: built so video calls don't freeze and movies don't buffer, even at 8 pm. Video call the grandkids with crisp audio and video.
          </p>
        </div>

        <div class="bg-slate-50 border border-slate-200 p-8 rounded-2xl shadow-xs space-y-4">
          <div class="w-12 h-12 rounded-xl bg-blue-100 text-infinite-blue flex items-center justify-center font-bold text-xl" aria-hidden="true">
            🛠️
          </div>
          <h2 class="text-xl font-bold text-navy-950">Local Wise County Support</h2>
          <p class="text-base text-slate-700 leading-relaxed font-normal">
            When you call <a href="tel:+19404370550" class="text-infinite-blue font-bold hover:underline">(940) 437-0550</a>, you speak with a neighbor, not a chatbot. Most problems are solved within the hour by phone or text.
          </p>
        </div>

      </div>

      <!-- Plan Pricing Matrix -->
      <div class="mb-20">
        <div class="text-center max-w-2xl mx-auto mb-12">
          <h2 class="text-3xl font-black text-navy-950">Internet Plans for Decatur Residents</h2>
          <p class="text-slate-700 text-base mt-2">All plans include zero contracts, no data overage charges, and local customer support.</p>
        </div>
        <PlanComparisonTable highlightedPlan="plus" />
      </div>

      <!-- Lead Capture -->
      <div class="max-w-3xl mx-auto mb-20" id="service-check">
        <ServiceAvailabilityForm 
          title="Check Service Availability in Decatur, TX"
          subtitle="Enter your street address below. Every install starts with a free line-of-sight check. If we can't give you a good connection, we'll tell you before you pay a dime."
        />
      </div>

      <!-- Local FAQ -->
      <FAQAccordion 
        faqs={decaturFaqs} 
        title="Decatur Internet Service FAQs" 
        subtitle="Answers to common questions from Decatur and Wise County homeowners."
      />

    </div>
  </div>
</BaseLayout>
