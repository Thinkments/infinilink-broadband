---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ServiceAvailabilityForm from '../../components/ServiceAvailabilityForm.astro';
import PlanComparisonTable from '../../components/PlanComparisonTable.astro';
import FAQAccordion from '../../components/FAQAccordion.astro';

const chicoFaqs = [
  {
    question: "Does Infinilink cover properties outside Chico city limits?",
    answer: "Yes. Our Northwest Wise County towers broadcast well beyond the Chico town boundary. We serve homes and ranches along US-287, CR 1560, CR 1590, and surrounding rural roads. Enter your address to confirm coverage."
  },
  {
    question: "How does fixed wireless compare to the DSL available in Chico?",
    answer: "Fixed wireless delivers faster, more consistent speeds than aging DSL phone lines. You'll typically see 75–100+ Mbps with Infinilink versus the 10–25 Mbps that DSL tops out at in most Chico areas — and with truly unlimited data."
  },
  {
    question: "What if trees or terrain block the signal to my Chico property?",
    answer: "Every install starts with a free line-of-sight check. Our local crew will assess your property and find the best antenna placement. If we can't deliver a solid connection, we'll tell you upfront — before you pay a dime."
  },
  {
    question: "Can I work from home on Infinilink in Chico?",
    answer: "Absolutely. Our Plus ($70/mo) and Premium ($110/mo) plans handle video calls, cloud file uploads, and VPN connections without the lag and dropouts that plague satellite and old DSL lines."
  }
];
---

<BaseLayout
  title="High Speed Internet Chico TX | Fast Unlimited Wireless"
  description="High-speed fixed wireless internet in Chico, TX (76431). Truly unlimited data, zero throttling, no contracts, and local Wise County support from Infinilink Broadband."
>
  <div class="py-16 sm:py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

      <!-- Header -->
      <div class="text-center max-w-3xl mx-auto mb-16">
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-blue-50 text-navy-900 border border-blue-200 text-sm font-semibold uppercase tracking-wider mb-4">
          <span class="w-2.5 h-2.5 rounded-full bg-emerald-600 inline-block"></span>
          Chico, Texas &bull; Northwest Wise County
        </div>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black text-navy-950 tracking-tight mb-6 leading-tight">
          High-Speed Internet in <br />
          <span class="text-infinite-blue">
            Chico, Texas (76431)
          </span>
        </h1>
        <p class="text-lg sm:text-xl text-slate-700 leading-relaxed font-normal">
          Tired of slow DSL and satellite dead zones? Infinilink delivers fast, steady fixed wireless broadband to Chico homes, ranches, and businesses along the US-287 corridor — with truly unlimited data and no contracts.
        </p>
      </div>

      <!-- Highlights -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-20">

        <div class="bg-slate-50 border border-slate-200 p-8 rounded-2xl shadow-xs space-y-4">
          <div class="w-12 h-12 rounded-xl bg-blue-100 text-infinite-blue flex items-center justify-center font-bold text-xl" aria-hidden="true">
            📡
          </div>
          <h2 class="text-xl font-bold text-navy-950">Northwest Wise County Towers</h2>
          <p class="text-base text-slate-700 leading-relaxed font-normal">
            Our local broadcast towers deliver strong, reliable signal across Chico, the US-287 corridor, and surrounding county roads and ranches.
          </p>
        </div>

        <div class="bg-slate-50 border border-slate-200 p-8 rounded-2xl shadow-xs space-y-4">
          <div class="w-12 h-12 rounded-xl bg-blue-100 text-infinite-blue flex items-center justify-center font-bold text-xl" aria-hidden="true">
            🏡
          </div>
          <h2 class="text-xl font-bold text-navy-950">Built for Rural Properties</h2>
          <p class="text-base text-slate-700 leading-relaxed font-normal">
            Whether you're on a ranch off CR 1560 or in town near the school, our fixed wireless reaches where cable companies won't run a line.
          </p>
        </div>

        <div class="bg-slate-50 border border-slate-200 p-8 rounded-2xl shadow-xs space-y-4">
          <div class="w-12 h-12 rounded-xl bg-blue-100 text-infinite-blue flex items-center justify-center font-bold text-xl" aria-hidden="true">
            ⚡
          </div>
          <h2 class="text-xl font-bold text-navy-950">Zero Throttling & Zero Caps</h2>
          <p class="text-base text-slate-700 leading-relaxed font-normal">
            Use as much data as your household needs. We never slow your speeds down or charge overage fees — stream, work, and game without limits.
          </p>
        </div>

      </div>

      <!-- Why Chico Residents Switch -->
      <div class="bg-blue-50 border-2 border-blue-200 rounded-2xl p-6 sm:p-8 mb-20 max-w-4xl mx-auto shadow-xs">
        <h2 class="text-2xl sm:text-3xl font-black text-navy-950 text-center mb-6">
          Why Chico Residents Are Switching to Infinilink
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          <div class="space-y-3">
            <div class="flex items-start gap-3">
              <svg class="w-5 h-5 text-infinite-blue shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path>
              </svg>
              <p class="text-base text-slate-800 font-medium"><strong class="text-navy-950">Faster than DSL</strong> — 75–100+ Mbps typical speeds versus the 10–25 Mbps most Chico DSL lines deliver.</p>
            </div>
            <div class="flex items-start gap-3">
              <svg class="w-5 h-5 text-infinite-blue shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path>
              </svg>
              <p class="text-base text-slate-800 font-medium"><strong class="text-navy-950">Lower latency than satellite</strong> — video calls actually work, gaming is smooth, and pages load instantly.</p>
            </div>
          </div>
          <div class="space-y-3">
            <div class="flex items-start gap-3">
              <svg class="w-5 h-5 text-infinite-blue shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path>
              </svg>
              <p class="text-base text-slate-800 font-medium"><strong class="text-navy-950">No contracts</strong> — month-to-month service. We earn your business, not lock you in.</p>
            </div>
            <div class="flex items-start gap-3">
              <svg class="w-5 h-5 text-infinite-blue shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path>
              </svg>
              <p class="text-base text-slate-800 font-medium"><strong class="text-navy-950">Real local support</strong> — call or text (940) 437-0550 and talk to a neighbor, not an offshore call center.</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Plan Pricing -->
      <div class="mb-20">
        <div class="text-center max-w-2xl mx-auto mb-12">
          <h2 class="text-3xl font-black text-navy-950">Chico Internet Plans</h2>
          <p class="text-slate-700 text-base mt-2">One flat price. No contracts. No data caps. No throttling. Same plans and prices for homes and businesses.</p>
        </div>
        <PlanComparisonTable highlightedPlan="plus" />
      </div>

      <!-- Lead Form -->
      <div class="max-w-3xl mx-auto mb-20" id="service-check">
        <ServiceAvailabilityForm
          title="Check Service Availability in Chico, TX"
          subtitle="Enter your street address below. Every install starts with a free line-of-sight check. If we can't give you a good connection, we'll tell you before you pay a dime."
        />
      </div>

      <FAQAccordion
        faqs={chicoFaqs}
        title="Chico Internet FAQs"
        subtitle="Common questions from Chico homeowners and property owners."
      />

    </div>
  </div>
</BaseLayout>
