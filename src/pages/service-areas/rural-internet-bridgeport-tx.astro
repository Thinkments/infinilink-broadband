---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ServiceAvailabilityForm from '../../components/ServiceAvailabilityForm.astro';
import PlanComparisonTable from '../../components/PlanComparisonTable.astro';
import FAQAccordion from '../../components/FAQAccordion.astro';

const bridgeportFaqs = [
  {
    question: "Do you service rural ranches and acreage properties in Bridgeport?",
    answer: "Yes. Our high-gain transceiver hardware connects sprawling ranches, CR roads, and agricultural facilities throughout the Bridgeport area that traditional cable and fiber providers do not reach."
  },
  {
    question: "Can I connect barns, workshops, and gate cameras on my Bridgeport ranch?",
    answer: "Yes. In addition to our standard whole-home installation, our technicians can install point-to-point wireless bridges to distribute high-speed internet across detached buildings and barns."
  },
  {
    question: "Are there long-term contracts required in Bridgeport?",
    answer: "No. All Infinilink residential internet plans are 100% month-to-month with zero contract lock-ins and zero early cancellation fees."
  }
];
---

<BaseLayout 
  title="Rural Internet Bridgeport TX | High Speed Fixed Wireless" 
  description="High-speed rural internet in Bridgeport, TX (76426). Truly unlimited data, low latency for gaming and Zoom, no contracts, and ranch property connectivity."
>
  <div class="py-16 sm:py-24 bg-slate-950">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Header -->
      <div class="text-center max-w-3xl mx-auto mb-16">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-cyan-950 text-cyan-400 border border-cyan-800 text-xs font-semibold uppercase tracking-wider mb-4">
          <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
          Bridgeport, Texas Service Hub
        </div>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black text-white tracking-tight mb-6 leading-tight">
          Rural High-Speed Internet in <br />
          <span class="bg-clip-text text-transparent bg-gradient-to-r from-blue-400 to-cyan-400">
            Bridgeport, Texas (76426)
          </span>
        </h1>
        <p class="text-lg text-slate-300 leading-relaxed">
          Broadband designed for Bridgeport’s agricultural acreage, ranches, and country homes. Experience fast, reliable connectivity with low ping, no data throttling, and local support.
        </p>
      </div>

      <!-- Highlights -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-20">
        
        <div class="bg-slate-900 border border-slate-800 p-8 rounded-2xl space-y-4">
          <div class="w-12 h-12 rounded-xl bg-blue-950 text-cyan-400 flex items-center justify-center font-bold text-xl">
            🚜
          </div>
          <h2 class="text-xl font-bold text-white">Ranch & Agricultural Reach</h2>
          <p class="text-sm text-slate-400 leading-relaxed">
            We specialize in providing rock-solid internet across expansive acreage, barndominiums, and rural properties along HWY 380, HWY 114, and local County Roads.
          </p>
        </div>

        <div class="bg-slate-900 border border-slate-800 p-8 rounded-2xl space-y-4">
          <div class="w-12 h-12 rounded-xl bg-cyan-950 text-cyan-400 flex items-center justify-center font-bold text-xl">
            💻
          </div>
          <h2 class="text-xl font-bold text-white">Reliable Work-From-Home</h2>
          <p class="text-sm text-slate-400 leading-relaxed">
            With low ping times and zero data limits, you can easily conduct video conferences, collaborate on large cloud files, and manage your business from your country property.
          </p>
        </div>

        <div class="bg-slate-900 border border-slate-800 p-8 rounded-2xl space-y-4">
          <div class="w-12 h-12 rounded-xl bg-emerald-950 text-emerald-400 flex items-center justify-center font-bold text-xl">
            🤝
          </div>
          <h2 class="text-xl font-bold text-white">Month-to-Month Freedom</h2>
          <p class="text-sm text-slate-400 leading-relaxed">
            No mandatory 2-year agreements. No surprise rate hikes. Enjoy honest pricing starting at $50/mo with our popular Plus Plan at $70/mo.
          </p>
        </div>

      </div>

      <!-- Plan Comparison Table -->
      <div class="mb-20">
        <div class="text-center max-w-2xl mx-auto mb-12">
          <h2 class="text-3xl font-black text-white">Bridgeport Internet Plans</h2>
          <p class="text-slate-400 text-sm mt-2">Unlimited data with zero throttling for Bridgeport families and businesses.</p>
        </div>
        <PlanComparisonTable highlightedPlan="plus" />
      </div>

      <!-- Lead Capture Form -->
      <div class="max-w-3xl mx-auto mb-20" id="service-check">
        <ServiceAvailabilityForm 
          title="Check Service Availability in Bridgeport, TX"
          subtitle="Submit your address to check line-of-sight and schedule your professional installation."
        />
      </div>

      <FAQAccordion 
        faqs={bridgeportFaqs} 
        title="Bridgeport Internet FAQs" 
        subtitle="Common questions from Bridgeport and Wise County residents."
      />

    </div>
  </div>
</BaseLayout>
