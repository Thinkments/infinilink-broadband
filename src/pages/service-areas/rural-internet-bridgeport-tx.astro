---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ServiceAvailabilityForm from '../../components/ServiceAvailabilityForm.astro';
import PlanComparisonTable from '../../components/PlanComparisonTable.astro';
import FAQAccordion from '../../components/FAQAccordion.astro';

const bridgeportFaqs = [
  {
    question: "Do you service rural ranches and acreage properties in Bridgeport?",
    answer: "Yes. Our high-gain antennas connect sprawling ranches, County Roads, and agricultural properties throughout the Bridgeport area where traditional cable and fiber providers won't go."
  },
  {
    question: "Can I connect barns, workshops, and outbuildings on my Bridgeport property?",
    answer: "Yes! Ask us about connecting barns, workshops, and outbuildings. We can set up wireless point-to-point links across your property to share your connection without running long trenches."
  },
  {
    question: "Are there long-term contracts required in Bridgeport?",
    answer: "No. All Infinilink internet plans are 100% month-to-month with no contracts and no surprise fees. One flat price every month."
  }
];
---

<BaseLayout 
  title="Rural Internet Bridgeport TX | High Speed Fixed Wireless" 
  description="High-speed rural internet in Bridgeport, TX (76426). Truly unlimited data, low lag, no contracts, and ranch property connectivity from $40/mo."
>
  <div class="py-16 sm:py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Header -->
      <div class="text-center max-w-3xl mx-auto mb-16">
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-blue-50 text-navy-900 border border-blue-200 text-sm font-semibold uppercase tracking-wider mb-4">
          <span class="w-2.5 h-2.5 rounded-full bg-emerald-600 inline-block"></span>
          Bridgeport, Texas Service Hub
        </div>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black text-navy-950 tracking-tight mb-6 leading-tight">
          Rural High-Speed Internet in <br />
          <span class="text-infinite-blue">
            Bridgeport, Texas (76426)
          </span>
        </h1>
        <p class="text-lg sm:text-xl text-slate-700 leading-relaxed font-normal">
          Broadband designed for Bridgeport's agricultural acreage, ranches, and country homes. Experience fast, reliable connectivity with low lag, no data throttling, and local support.
        </p>
      </div>

      <!-- Highlights -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-20">
        
        <div class="bg-slate-50 border border-slate-200 p-8 rounded-2xl shadow-xs space-y-4">
          <div class="w-12 h-12 rounded-xl bg-blue-100 text-infinite-blue flex items-center justify-center font-bold text-xl" aria-hidden="true">
            🚜
          </div>
          <h2 class="text-xl font-bold text-navy-950">Ranch & Acreage Reach</h2>
          <p class="text-base text-slate-700 leading-relaxed font-normal">
            We specialize in providing steady internet across expansive acreage, barndominiums, and rural properties along HWY 380, HWY 114, and local County Roads.
          </p>
        </div>

        <div class="bg-slate-50 border border-slate-200 p-8 rounded-2xl shadow-xs space-y-4">
          <div class="w-12 h-12 rounded-xl bg-blue-100 text-infinite-blue flex items-center justify-center font-bold text-xl" aria-hidden="true">
            💻
          </div>
          <h2 class="text-xl font-bold text-navy-950">Reliable Work-From-Home</h2>
          <p class="text-base text-slate-700 leading-relaxed font-normal">
            Fast is nice, steady is better: built so video calls don't freeze and movies don't buffer, even at 8 pm. Real speeds, not "up to" speeds.
          </p>
        </div>

        <div class="bg-slate-50 border border-slate-200 p-8 rounded-2xl shadow-xs space-y-4">
          <div class="w-12 h-12 rounded-xl bg-blue-100 text-infinite-blue flex items-center justify-center font-bold text-xl" aria-hidden="true">
            🤝
          </div>
          <h2 class="text-xl font-bold text-navy-950">Month-to-Month Freedom</h2>
          <p class="text-base text-slate-700 leading-relaxed font-normal">
            No contracts. No teaser rates that double later. One flat price every month starting at $40/mo. Pay by check, phone, or online.
          </p>
        </div>

      </div>

      <!-- Plan Comparison Table -->
      <div class="mb-20">
        <div class="text-center max-w-2xl mx-auto mb-12">
          <h2 class="text-3xl font-black text-navy-950">Bridgeport Internet Plans</h2>
          <p class="text-slate-700 text-base mt-2">Unlimited data with zero throttling for Bridgeport families and businesses.</p>
        </div>
        <PlanComparisonTable highlightedPlan="plus" />
      </div>

      <!-- Lead Capture Form -->
      <div class="max-w-3xl mx-auto mb-20" id="service-check">
        <ServiceAvailabilityForm 
          title="Check Service Availability in Bridgeport, TX"
          subtitle="Submit your address below. Every install starts with a free line-of-sight check. If we can't give you a good connection, we'll tell you before you pay a dime."
        />
      </div>

      <FAQAccordion 
        faqs={bridgeportFaqs} 
        title="Bridgeport Internet FAQs" 
        subtitle="Common questions from Bridgeport and Wise County residents."
      />

    </div>
  </div>
</BaseLayout>
