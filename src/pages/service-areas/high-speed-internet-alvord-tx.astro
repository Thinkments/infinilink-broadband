---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ServiceAvailabilityForm from '../../components/ServiceAvailabilityForm.astro';
import PlanComparisonTable from '../../components/PlanComparisonTable.astro';
import FAQAccordion from '../../components/FAQAccordion.astro';

const alvordFaqs = [
  {
    question: "How far north into Alvord does Infinilink's coverage reach?",
    answer: "Our North Wise County broadcast towers provide coverage throughout the City of Alvord, FM 1655, US-287, and surrounding rural acreage up toward the county line."
  },
  {
    question: "Can multiple people stream TV and join calls at the same time in Alvord?",
    answer: "Yes. Our Plus ($70/mo) and Premium ($110/mo) plans are built for busy households with several TVs and smart devices online at once."
  },
  {
    question: "How do I switch from slow DSL or satellite in Alvord?",
    answer: "Getting started is easy. Enter your address in our form or call (940) 437-0550. Our local team will schedule a free line-of-sight check and get you set up."
  }
];
---

<BaseLayout 
  title="High Speed Internet Alvord TX | Fast Unlimited Wireless" 
  description="High-speed fixed wireless internet provider in Alvord, TX (76225). Unlimited data, zero throttling, steady speeds, and local North Wise County support."
>
  <div class="py-16 sm:py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Header -->
      <div class="text-center max-w-3xl mx-auto mb-16">
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-blue-50 text-navy-900 border border-blue-200 text-sm font-semibold uppercase tracking-wider mb-4">
          <span class="w-2.5 h-2.5 rounded-full bg-emerald-600 inline-block"></span>
          Alvord, Texas • North Wise County
        </div>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black text-navy-950 tracking-tight mb-6 leading-tight">
          High-Speed Internet in <br />
          <span class="text-infinite-blue">
            Alvord, Texas (76225)
          </span>
        </h1>
        <p class="text-lg sm:text-xl text-slate-700 leading-relaxed font-normal">
          Say goodbye to sluggish copper phone lines and restrictive satellite data caps. Infinilink provides high-speed, low-lag fixed wireless broadband directly to Alvord homes and ranches.
        </p>
      </div>

      <!-- Highlights -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-20">
        
        <div class="bg-slate-50 border border-slate-200 p-8 rounded-2xl shadow-xs space-y-4">
          <div class="w-12 h-12 rounded-xl bg-blue-100 text-infinite-blue flex items-center justify-center font-bold text-xl" aria-hidden="true">
            📡
          </div>
          <h2 class="text-xl font-bold text-navy-950">North Wise County Tower Reach</h2>
          <p class="text-base text-slate-700 leading-relaxed font-normal">
            Broadcasting to Alvord neighborhoods, FM corridors, and rural ranches with strong, stable signals from local towers.
          </p>
        </div>

        <div class="bg-slate-50 border border-slate-200 p-8 rounded-2xl shadow-xs space-y-4">
          <div class="w-12 h-12 rounded-xl bg-blue-100 text-infinite-blue flex items-center justify-center font-bold text-xl" aria-hidden="true">
            📺
          </div>
          <h2 class="text-xl font-bold text-navy-950">Multi-Device Streaming</h2>
          <p class="text-base text-slate-700 leading-relaxed font-normal">
            Stream your favorite TV shows and movies without buffering. Video call the grandkids without the picture freezing.
          </p>
        </div>

        <div class="bg-slate-50 border border-slate-200 p-8 rounded-2xl shadow-xs space-y-4">
          <div class="w-12 h-12 rounded-xl bg-blue-100 text-infinite-blue flex items-center justify-center font-bold text-xl" aria-hidden="true">
            ⚡
          </div>
          <h2 class="text-xl font-bold text-navy-950">Zero Throttling & Zero Caps</h2>
          <p class="text-base text-slate-700 leading-relaxed font-normal">
            Use as much data as your household needs. We never slow your speeds down or charge overage fees on your bill.
          </p>
        </div>

      </div>

      <!-- Plan Pricing -->
      <div class="mb-20">
        <div class="text-center max-w-2xl mx-auto mb-12">
          <h2 class="text-3xl font-black text-navy-950">Alvord Internet Plans</h2>
          <p class="text-slate-700 text-base mt-2">One flat price. No contracts. No data caps. No throttling. Same plans and prices for homes and businesses.</p>
        </div>
        <PlanComparisonTable highlightedPlan="plus" />
      </div>

      <!-- Lead Form -->
      <div class="max-w-3xl mx-auto mb-20" id="service-check">
        <ServiceAvailabilityForm 
          title="Check Service Availability in Alvord, TX"
          subtitle="Enter your street address below. Every install starts with a free line-of-sight check. If we can't give you a good connection, we'll tell you before you pay a dime."
        />
      </div>

      <FAQAccordion 
        faqs={alvordFaqs} 
        title="Alvord Internet FAQs" 
        subtitle="Common questions from Alvord homeowners and landowners."
      />

    </div>
  </div>
</BaseLayout>
