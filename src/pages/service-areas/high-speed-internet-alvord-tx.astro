---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ServiceAvailabilityForm from '../../components/ServiceAvailabilityForm.astro';
import PlanComparisonTable from '../../components/PlanComparisonTable.astro';
import FAQAccordion from '../../components/FAQAccordion.astro';

const alvordFaqs = [
  {
    question: "How far north into Alvord does Infinilink's coverage reach?",
    answer: "Our North Wise County broadcast towers provide extensive coverage throughout the City of Alvord, FM 1655, US-287, and surrounding rural acreage up toward the Montague County line."
  },
  {
    question: "Can multiple people stream 4K and play games simultaneously in Alvord?",
    answer: "Yes. Our Plus ($70/mo) and Premium ($110/mo) plans provide dedicated low-latency bandwidth channels built specifically for multiple concurrent high-demand users."
  },
  {
    question: "How do I switch from slow DSL or satellite in Alvord?",
    answer: "Getting started is easy. Enter your address in our form or call (940) 437-0550. Our Decatur dispatch team will schedule a free line-of-sight test and install your receiver."
  }
];
---

<BaseLayout 
  title="High Speed Internet Alvord TX | Fast Unlimited Wireless" 
  description="High-speed fixed wireless internet provider in Alvord, TX (76225). Unlimited data, zero throttling, low latency gaming, and local North Wise County support."
>
  <div class="py-16 sm:py-24 bg-slate-950">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Header -->
      <div class="text-center max-w-3xl mx-auto mb-16">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-cyan-950 text-cyan-400 border border-cyan-800 text-xs font-semibold uppercase tracking-wider mb-4">
          <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
          Alvord, Texas • North Wise County Hub
        </div>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black text-white tracking-tight mb-6 leading-tight">
          High-Speed Internet in <br />
          <span class="bg-clip-text text-transparent bg-gradient-to-r from-blue-400 to-cyan-400">
            Alvord, Texas (76225)
          </span>
        </h1>
        <p class="text-lg text-slate-300 leading-relaxed">
          Say goodbye to sluggish copper phone lines and restrictive satellite data caps. Infinilink provides high-speed, low-ping fixed wireless broadband directly to Alvord homes and ranches.
        </p>
      </div>

      <!-- Highlights -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-20">
        
        <div class="bg-slate-900 border border-slate-800 p-8 rounded-2xl space-y-4">
          <div class="w-12 h-12 rounded-xl bg-blue-950 text-cyan-400 flex items-center justify-center font-bold text-xl">
            📡
          </div>
          <h2 class="text-xl font-bold text-white">North Wise County Tower Reach</h2>
          <p class="text-sm text-slate-400 leading-relaxed">
            Engineered with high-elevation transmitters covering Alvord, FM corridors, and rural ranches with strong, stable microwave signals.
          </p>
        </div>

        <div class="bg-slate-900 border border-slate-800 p-8 rounded-2xl space-y-4">
          <div class="w-12 h-12 rounded-xl bg-cyan-950 text-cyan-400 flex items-center justify-center font-bold text-xl">
            📺
          </div>
          <h2 class="text-xl font-bold text-white">Multi-Device 4K Streaming</h2>
          <p class="text-sm text-slate-400 leading-relaxed">
            Stream your favorite TV shows, football games, and movies across multiple smart TVs simultaneously with zero buffering or slowdowns.
          </p>
        </div>

        <div class="bg-slate-900 border border-slate-800 p-8 rounded-2xl space-y-4">
          <div class="w-12 h-12 rounded-xl bg-emerald-950 text-emerald-400 flex items-center justify-center font-bold text-xl">
            ⚡
          </div>
          <h2 class="text-xl font-bold text-white">Zero Throttling Guaranteed</h2>
          <p class="text-sm text-slate-400 leading-relaxed">
            Use as much data as your household needs. We never slow your speeds down or charge overage fees during peak hours.
          </p>
        </div>

      </div>

      <!-- Plan Pricing -->
      <div class="mb-20">
        <div class="text-center max-w-2xl mx-auto mb-12">
          <h2 class="text-3xl font-black text-white">Alvord Broadband Packages</h2>
          <p class="text-slate-400 text-sm mt-2">Plus ($70/mo) and Premium ($110/mo) packages with zero contracts.</p>
        </div>
        <PlanComparisonTable highlightedPlan="plus" />
      </div>

      <!-- Lead Form -->
      <div class="max-w-3xl mx-auto mb-20" id="service-check">
        <ServiceAvailabilityForm 
          title="Check Service Availability in Alvord, TX"
          subtitle="Enter your street address to confirm line-of-sight and schedule your installation."
        />
      </div>

      <FAQAccordion 
        faqs={alvordFaqs} 
        title="Alvord Internet FAQs" 
        subtitle="Common questions from Alvord homeowners and landowners."
      />

    </div>
  </div>
</BaseLayout>
