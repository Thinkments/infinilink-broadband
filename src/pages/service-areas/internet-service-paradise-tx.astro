---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ServiceAvailabilityForm from '../../components/ServiceAvailabilityForm.astro';
import PlanComparisonTable from '../../components/PlanComparisonTable.astro';
import FAQAccordion from '../../components/FAQAccordion.astro';

const paradiseFaqs = [
  {
    question: "Do you service residential subdivisions and ranches in Paradise, TX?",
    answer: "Yes. Our South Wise County broadcast towers provide steady line-of-sight coverage throughout the City of Paradise, surrounding rural subdivisions, and country ranches."
  },
  {
    question: "Why choose Infinilink over satellite providers in Paradise?",
    answer: "Infinilink provides land-based wireless with low lag (typical ping 20–35ms), zero data caps, steady performance during North Texas weather, and direct phone support from real local people."
  },
  {
    question: "What is included with installation in Paradise?",
    answer: "We do it all: the antenna, the router, and your Wi-Fi. We wire everything cleanly, connect your devices, and test it before we leave. No tech talk required."
  }
];
---

<BaseLayout 
  title="High Speed Internet Paradise TX | Local Provider" 
  description="Fast, reliable fixed wireless internet for Paradise, TX (76073) and South Wise County. Zero data caps, steady speeds, no contracts, and local support."
>
  <div class="py-16 sm:py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Header -->
      <div class="text-center max-w-3xl mx-auto mb-16">
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-blue-50 text-navy-900 border border-blue-200 text-sm font-semibold uppercase tracking-wider mb-4">
          <span class="w-2.5 h-2.5 rounded-full bg-emerald-600 inline-block"></span>
          Paradise, Texas • South Wise County
        </div>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black text-navy-950 tracking-tight mb-6 leading-tight">
          High-Speed Internet in <br />
          <span class="text-infinite-blue">
            Paradise, Texas (76073)
          </span>
        </h1>
        <p class="text-lg sm:text-xl text-slate-700 leading-relaxed font-normal">
          Get the reliable broadband your family deserves. Infinilink delivers high-speed fixed wireless internet with low lag, unlimited data, and local Wise County customer service.
        </p>
      </div>

      <!-- Highlights -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-20">
        
        <div class="bg-slate-50 border border-slate-200 p-8 rounded-2xl shadow-xs space-y-4">
          <div class="w-12 h-12 rounded-xl bg-blue-100 text-infinite-blue flex items-center justify-center font-bold text-xl" aria-hidden="true">
            📡
          </div>
          <h2 class="text-xl font-bold text-navy-950">South Wise County Tower Reach</h2>
          <p class="text-base text-slate-700 leading-relaxed font-normal">
            Direct wireless links connecting Paradise neighborhoods, ranches, and country estates with reliable high-speed broadband.
          </p>
        </div>

        <div class="bg-slate-50 border border-slate-200 p-8 rounded-2xl shadow-xs space-y-4">
          <div class="w-12 h-12 rounded-xl bg-blue-100 text-infinite-blue flex items-center justify-center font-bold text-xl" aria-hidden="true">
            📺
          </div>
          <h2 class="text-xl font-bold text-navy-950">Steady Streaming & Video Calls</h2>
          <p class="text-base text-slate-700 leading-relaxed font-normal">
            Fast is nice, steady is better: built so video calls don't freeze and movies don't buffer, even at 8 pm. Video call the grandkids without the picture freezing.
          </p>
        </div>

        <div class="bg-slate-50 border border-slate-200 p-8 rounded-2xl shadow-xs space-y-4">
          <div class="w-12 h-12 rounded-xl bg-blue-100 text-infinite-blue flex items-center justify-center font-bold text-xl" aria-hidden="true">
            ⭐
          </div>
          <h2 class="text-xl font-bold text-navy-950">Locally Owned & Family Operated</h2>
          <p class="text-base text-slate-700 leading-relaxed font-normal">
            Support a local Wise County family business that lives here, uses this internet at home, and provides personal, attentive service.
          </p>
        </div>

      </div>

      <!-- Plan Pricing -->
      <div class="mb-20">
        <div class="text-center max-w-2xl mx-auto mb-12">
          <h2 class="text-3xl font-black text-navy-950">Paradise Internet Plans</h2>
          <p class="text-slate-700 text-base mt-2">One flat price. No contracts. No data caps. No throttling. Same plans and prices for homes and businesses.</p>
        </div>
        <PlanComparisonTable highlightedPlan="plus" />
      </div>

      <!-- Lead Form -->
      <div class="max-w-3xl mx-auto mb-20" id="service-check">
        <ServiceAvailabilityForm 
          title="Check Service Availability in Paradise, TX"
          subtitle="Enter your street address below. Every install starts with a free line-of-sight check. If we can't give you a good connection, we'll tell you before you pay a dime."
        />
      </div>

      <FAQAccordion 
        faqs={paradiseFaqs} 
        title="Paradise Internet FAQs" 
        subtitle="Common questions from Paradise and South Wise County residents."
      />

    </div>
  </div>
</BaseLayout>
