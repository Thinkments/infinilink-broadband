---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ServiceAvailabilityForm from '../../components/ServiceAvailabilityForm.astro';
import PlanComparisonTable from '../../components/PlanComparisonTable.astro';
import FAQAccordion from '../../components/FAQAccordion.astro';

const runawayBayFaqs = [
  {
    question: "Do you provide coverage across Lake Bridgeport waterfront properties?",
    answer: "Yes. Our high-elevation tower arrays offer unobstructed line-of-sight across Lake Bridgeport and the entire Runaway Bay peninsula, delivering high-speed fixed wireless directly to lakeside homes and docks."
  },
  {
    question: "Can I use Infinilink for a vacation home or part-time lake house?",
    answer: "Yes. With our 100% month-to-month, no-contract pricing, you have total flexibility for vacation homes, rental retreats, or year-round residency."
  },
  {
    question: "Will lake fog or storms interrupt our internet?",
    answer: "No. Unlike satellite dishes that suffer from rain fade during heavy clouds, our terrestrial microwave links operate on resilient commercial frequencies engineered to withstand North Texas weather."
  }
];
---

<BaseLayout 
  title="Internet Provider Runaway Bay TX | High Speed Lake Bridgeport" 
  description="Fast, reliable fixed wireless internet for Runaway Bay & Lake Bridgeport, TX. Zero data caps, buffer-free streaming, low ping, and month-to-month lake home plans."
>
  <div class="py-16 sm:py-24 bg-slate-950">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Header -->
      <div class="text-center max-w-3xl mx-auto mb-16">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-cyan-950 text-cyan-400 border border-cyan-800 text-xs font-semibold uppercase tracking-wider mb-4">
          <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
          Runaway Bay & Lake Bridgeport Service Hub
        </div>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black text-white tracking-tight mb-6 leading-tight">
          High-Speed Internet in <br />
          <span class="bg-clip-text text-transparent bg-gradient-to-r from-blue-400 to-cyan-400">
            Runaway Bay, Texas (76426)
          </span>
        </h1>
        <p class="text-lg text-slate-300 leading-relaxed">
          Reliable, low-latency fixed wireless broadband across the Lake Bridgeport shoreline. Enjoy seamless 4K streaming, remote work videoconferencing, and smart home security with zero data caps.
        </p>
      </div>

      <!-- Highlights -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-20">
        
        <div class="bg-slate-900 border border-slate-800 p-8 rounded-2xl space-y-4">
          <div class="w-12 h-12 rounded-xl bg-blue-950 text-cyan-400 flex items-center justify-center font-bold text-xl">
            🌊
          </div>
          <h2 class="text-xl font-bold text-white">Unobstructed Lake Line-of-Sight</h2>
          <p class="text-sm text-slate-400 leading-relaxed">
            The open water of Lake Bridgeport provides ideal microwave propagation paths. Our high-gain receivers deliver consistent bandwidth without expensive trenching.
          </p>
        </div>

        <div class="bg-slate-900 border border-slate-800 p-8 rounded-2xl space-y-4">
          <div class="w-12 h-12 rounded-xl bg-cyan-950 text-cyan-400 flex items-center justify-center font-bold text-xl">
            🏡
          </div>
          <h2 class="text-xl font-bold text-white">Vacation Home & Full-Time Flexibility</h2>
          <p class="text-sm text-slate-400 leading-relaxed">
            Whether you reside in Runaway Bay full-time or manage a weekend lake house, our no-contract plans provide reliable high-speed Wi-Fi and smart security camera streaming 24/7.
          </p>
        </div>

        <div class="bg-slate-900 border border-slate-800 p-8 rounded-2xl space-y-4">
          <div class="w-12 h-12 rounded-xl bg-emerald-950 text-emerald-400 flex items-center justify-center font-bold text-xl">
            🚀
          </div>
          <h2 class="text-xl font-bold text-white">Buffer-Free Multi-Device 4K</h2>
          <p class="text-sm text-slate-400 leading-relaxed">
            Stream simultaneous live sports, movies, and music across your patio and boat dock. Zero data caps mean your household can stream without worry.
          </p>
        </div>

      </div>

      <!-- Plan Comparison Table -->
      <div class="mb-20">
        <div class="text-center max-w-2xl mx-auto mb-12">
          <h2 class="text-3xl font-black text-white">Runaway Bay Broadband Packages</h2>
          <p class="text-slate-400 text-sm mt-2">Plus ($70/mo) and Premium ($110/mo) tiers engineered for modern multi-device lake properties.</p>
        </div>
        <PlanComparisonTable highlightedPlan="plus" />
      </div>

      <!-- Lead Capture Form -->
      <div class="max-w-3xl mx-auto mb-20" id="service-check">
        <ServiceAvailabilityForm 
          title="Check Runaway Bay / Lake Bridgeport Availability"
          subtitle="Enter your street address to verify immediate coverage from our Lake Bridgeport relay towers."
        />
      </div>

      <FAQAccordion 
        faqs={runawayBayFaqs} 
        title="Runaway Bay Internet FAQs" 
        subtitle="Common questions from Runaway Bay and Lake Bridgeport homeowners."
      />

    </div>
  </div>
</BaseLayout>
