---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ServiceAvailabilityForm from '../../components/ServiceAvailabilityForm.astro';
import PlanComparisonTable from '../../components/PlanComparisonTable.astro';
import FAQAccordion from '../../components/FAQAccordion.astro';

const runawayBayFaqs = [
  {
    question: "Do you provide coverage across Lake Bridgeport waterfront properties?",
    answer: "Yes. Our high-elevation tower arrays offer clear line-of-sight across Lake Bridgeport and the entire Runaway Bay peninsula, delivering steady wireless directly to lakeside homes and docks."
  },
  {
    question: "Can I use Infinilink for a vacation home or part-time lake house?",
    answer: "Yes. With our 100% month-to-month, no-contract pricing, you have total flexibility for vacation homes, weekend retreats, or year-round residency. One flat price every month."
  },
  {
    question: "Will lake fog or rain interrupt our internet?",
    answer: "No. Unlike satellite dishes that suffer from rain fade during heavy clouds, our land-based wireless towers are located right here in Wise County, keeping your connection steady during North Texas weather."
  }
];
---

<BaseLayout 
  title="Internet Provider Runaway Bay TX | Infinilink Broadband Hometown" 
  description="Fast, reliable fixed wireless internet for Runaway Bay & Lake Bridgeport, TX. Zero data caps, buffer-free streaming, low lag, and local family support from $40/mo."
>
  <div class="py-16 sm:py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Header -->
      <div class="text-center max-w-3xl mx-auto mb-16">
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-blue-50 text-navy-900 border border-blue-200 text-sm font-semibold uppercase tracking-wider mb-4">
          <span class="w-2.5 h-2.5 rounded-full bg-emerald-600 inline-block"></span>
          Runaway Bay, TX • Hometown Hub
        </div>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black text-navy-950 tracking-tight mb-6 leading-tight">
          High-Speed Internet in <br />
          <span class="text-infinite-blue">
            Runaway Bay, Texas (76426)
          </span>
        </h1>
        <p class="text-lg sm:text-xl text-slate-700 leading-relaxed font-normal">
          Infinilink was born right here in Runaway Bay. Reliable, low-lag internet across the Lake Bridgeport shoreline. Enjoy smooth video calls, streaming TV, and home security with zero data caps and no contracts.
        </p>
      </div>

      <!-- Highlights -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-20">
        
        <div class="bg-slate-50 border border-slate-200 p-8 rounded-2xl shadow-xs space-y-4">
          <div class="w-12 h-12 rounded-xl bg-blue-100 text-infinite-blue flex items-center justify-center font-bold text-xl" aria-hidden="true">
            🌊
          </div>
          <h2 class="text-xl font-bold text-navy-950">Clear Lake Line-of-Sight</h2>
          <p class="text-base text-slate-700 leading-relaxed font-normal">
            The open water of Lake Bridgeport provides ideal wireless paths. Our small roof antennas deliver consistent speeds without digging up your yard.
          </p>
        </div>

        <div class="bg-slate-50 border border-slate-200 p-8 rounded-2xl shadow-xs space-y-4">
          <div class="w-12 h-12 rounded-xl bg-blue-100 text-infinite-blue flex items-center justify-center font-bold text-xl" aria-hidden="true">
            🏡
          </div>
          <h2 class="text-xl font-bold text-navy-950">Lake Home & Full-Time Flexibility</h2>
          <p class="text-base text-slate-700 leading-relaxed font-normal">
            Whether you live in Runaway Bay year-round or enjoy a weekend retreat on the lake, our month-to-month plans mean you are never trapped in a contract.
          </p>
        </div>

        <div class="bg-slate-50 border border-slate-200 p-8 rounded-2xl shadow-xs space-y-4">
          <div class="w-12 h-12 rounded-xl bg-blue-100 text-infinite-blue flex items-center justify-center font-bold text-xl" aria-hidden="true">
            📺
          </div>
          <h2 class="text-xl font-bold text-navy-950">Steady Streaming & Calls</h2>
          <p class="text-base text-slate-700 leading-relaxed font-normal">
            Fast is nice, steady is better: built so video calls don't freeze and movies don't buffer, even at 8 pm. Video call the grandkids without the picture freezing.
          </p>
        </div>

      </div>

      <!-- Plan Comparison Table -->
      <div class="mb-20">
        <div class="text-center max-w-2xl mx-auto mb-12">
          <h2 class="text-3xl font-black text-navy-950">Runaway Bay Internet Plans</h2>
          <p class="text-slate-700 text-base mt-2">One flat price. No contracts. No data caps. No throttling. Same plans and prices for homes and businesses.</p>
        </div>
        <PlanComparisonTable highlightedPlan="plus" />
      </div>

      <!-- Lead Capture Form -->
      <div class="max-w-3xl mx-auto mb-20" id="service-check">
        <ServiceAvailabilityForm 
          title="Check Runaway Bay / Lake Bridgeport Availability"
          subtitle="Enter your street address below. Every install starts with a free line-of-sight check. If we can't give you a good connection, we'll tell you before you pay a dime."
        />
      </div>

      <FAQAccordion 
        faqs={runawayBayFaqs} 
        title="Runaway Bay Internet FAQs" 
        subtitle="Common questions from Runaway Bay and Lake Bridgeport homeowners."
      />

    </div>
  </div>
</BaseLayout>
