---
import BaseLayout from '../layouts/BaseLayout.astro';
import ServiceAvailabilityForm from '../components/ServiceAvailabilityForm.astro';
import FAQAccordion from '../components/FAQAccordion.astro';

const steps = [
  {
    step: "01",
    title: "Triple Fiber Feeds",
    desc: "Three separate fiber lines feed our towers across Wise County. If one provider experiences an outage, our backup lines keep you connected."
  },
  {
    step: "02",
    title: "Local Tower Broadcast",
    desc: "Clean wireless signals travel directly from our local towers across the county. No aging copper phone lines or cables to dig up."
  },
  {
    step: "03",
    title: "Small Roof Antenna",
    desc: "Our local family team mounts a small, discreet antenna on your roof or fascia, aimed directly at the nearest Wise County tower."
  },
  {
    step: "04",
    title: "Your Home Wi-Fi",
    desc: "We do it all: the antenna, the router, and your Wi-Fi. We wire everything cleanly, connect your devices, and test it before we leave."
  }
];
---

<BaseLayout 
  title="How Fixed Wireless Works | Infinilink Broadband Wise County TX" 
  description="Discover how fixed wireless internet delivers steady, reliable broadband to Wise County homes and ranches without satellite lag or phone lines."
>
  <div class="py-16 sm:py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Header -->
      <div class="text-center max-w-3xl mx-auto mb-16">
        <span class="inline-flex items-center px-4 py-1.5 rounded-full text-sm font-bold bg-blue-50 text-navy-900 border border-blue-200 uppercase tracking-wider mb-4">
          Simple Technology, Real Reliability
        </span>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black text-navy-950 tracking-tight mb-4">
          How Fixed Wireless Delivers Internet Through the Air
        </h1>
        <p class="text-lg sm:text-xl text-slate-700 font-normal leading-relaxed">
          Fast is nice. Steady is better. Built so video calls don't freeze and movies don't buffer, even at 8 pm. Terrestrial towers mean steady speeds without satellite lag or buried cables.
        </p>
      </div>

      <!-- 4-Step Architecture -->
      <div class="mb-20">
        <div class="text-center mb-10">
          <h2 class="text-2xl sm:text-3xl font-black text-navy-950">How Your Connection Works in 4 Steps</h2>
          <p class="text-slate-700 text-base mt-2 font-medium">From our fiber-connected towers straight into your living room.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
          {steps.map((item) => (
            <div class="bg-slate-50 border border-slate-200 p-6 rounded-2xl relative overflow-hidden group hover:border-infinite-blue shadow-xs transition">
              <div class="text-4xl font-black text-infinite-blue mb-4" aria-hidden="true">
                {item.step}
              </div>
              <h3 class="text-xl font-bold text-navy-950 mb-2">{item.title}</h3>
              <p class="text-base text-slate-700 leading-relaxed font-normal">{item.desc}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- Technical Comparison Section -->
      <div class="bg-slate-50 border border-slate-200 rounded-3xl p-8 sm:p-12 mb-20 shadow-xs">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 items-center">
          <div class="space-y-6">
            <h2 class="text-3xl font-black text-navy-950 tracking-tight">
              Why Local Towers Beat Satellite Internet
            </h2>
            <p class="text-slate-700 text-base leading-relaxed">
              When data travels tens of thousands of miles into space and back, physics creates unavoidable lag. That lag causes your video calls to freeze and movies to pause to buffer.
            </p>
            <p class="text-slate-700 text-base leading-relaxed">
              Infinilink's towers are right here in Wise County (Runaway Bay, Bridgeport, Decatur). Because signals travel just a few miles over land, you get a crisp, steady connection with <strong class="text-navy-950 font-bold">typical ping times of 20–35ms</strong>.
            </p>

            <ul class="space-y-3 text-base text-slate-700 font-medium">
              <li class="flex items-center gap-2">
                <span class="text-emerald-700 font-bold text-lg" aria-hidden="true">✓</span>
                <span>Steady performance through cloud and rain</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="text-emerald-700 font-bold text-lg" aria-hidden="true">✓</span>
                <span>No buried phone lines vulnerable to road work or backhoes</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="text-emerald-700 font-bold text-lg" aria-hidden="true">✓</span>
                <span>Works smoothly with all your phones, tablets, and smart TVs</span>
              </li>
            </ul>
          </div>

          <div class="bg-white border border-slate-200 p-6 rounded-2xl shadow-xs">
            <h3 class="text-xl font-bold text-navy-950 mb-4 text-center">Distance & Lag Comparison</h3>
            <div class="space-y-4">
              <div class="p-4 bg-blue-50/60 rounded-xl border-2 border-infinite-blue shadow-xs">
                <div class="flex justify-between items-center mb-1">
                  <span class="font-bold text-navy-950 text-base">Infinilink Fixed Wireless</span>
                  <span class="text-infinite-blue font-black text-base">20–35 ms Typical Ping</span>
                </div>
                <p class="text-slate-700 text-sm font-medium">Distance: 3–8 miles across Wise County</p>
              </div>

              <div class="p-4 bg-slate-50 rounded-xl border border-slate-200">
                <div class="flex justify-between items-center mb-1">
                  <span class="font-bold text-slate-900 text-base">Orbiting Satellite</span>
                  <span class="text-amber-900 font-bold text-base">50–90 ms Lag</span>
                </div>
                <p class="text-slate-600 text-sm font-medium">Distance: 300+ miles into orbit</p>
              </div>

              <div class="p-4 bg-slate-50 rounded-xl border border-slate-200">
                <div class="flex justify-between items-center mb-1">
                  <span class="font-bold text-slate-900 text-base">Older Geostationary Satellite</span>
                  <span class="text-rose-900 font-bold text-base">600–800 ms Lag</span>
                </div>
                <p class="text-slate-600 text-sm font-medium">Distance: 22,000+ miles into deep space</p>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Lead Capture Form -->
      <div class="max-w-3xl mx-auto mb-20" id="service-check">
        <ServiceAvailabilityForm 
          title="Verify Line of Sight at Your Property"
          subtitle="Submit your address below. Every install starts with a free line-of-sight check. If we can't give you a good connection, we'll tell you before you pay a dime."
        />
      </div>

      <FAQAccordion />

    </div>
  </div>
</BaseLayout>
